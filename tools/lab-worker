#!/usr/bin/env bash
# lab-worker — one Claude Code session, one job. The default `[worker] command`.
#
# `lab run` launches this under a watcher with the worker contract in the environment
# (see tools/lab_campaign.py). It renders the job card, runs ONE headless Claude Code
# session on subscription login, then checks the contract mechanically: code/run.sh
# and the search predictions must exist. It never reads labels, never spawns a second
# session, and exits non-zero when the contract is unmet so the loop records the
# candidate as invalid instead of guessing.
#
# Exit codes: 0 contract met · 2 contract unmet (session ran) · 3 session failed to start
set -uo pipefail

: "${LAB_CANDIDATE_DIR:?lab-worker must be launched by lab run}"
: "${LAB_JOB:?}" "${LAB_PREDICTIONS_OUT:?}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAB="$HERE/lab"
ROOT="${LAB_ROOT:-$(cd "$HERE/.." && pwd)}"
cd "$ROOT" || exit 3

model="${LAB_WORKER_MODEL:-claude-sonnet-5}"
turns="${LAB_WORKER_MAX_TURNS:-40}"
mode="${LAB_PERMISSION_MODE:-auto}"
cid="$(basename "$LAB_CANDIDATE_DIR")"

# Subscription login only: refuse a paid route rather than silently billing it.
for v in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX; do
  if [ -n "${!v:-}" ]; then
    echo "lab-worker: $v is set; the loop runs on subscription login only (NEXT.md §4)" >&2
    exit 3
  fi
done
command -v claude >/dev/null 2>&1 || { echo "lab-worker: no \`claude\` on PATH" >&2; exit 3; }

card="$("$LAB" job card "$LAB_CANDIDATE_DIR")" || { echo "lab-worker: no job card" >&2; exit 3; }
export LAB_MODEL="$model" LAB_ROLE=worker
echo "lab-worker: $cid ${LAB_OPERATOR:-?} model=$model max-turns=$turns mode=$mode"

# One session. `--output-format json` gives one result object: session_id, num_turns,
# duration, usage, the final text. Stored beside the candidate as provenance; the
# SessionStart hook records the transcript path for `lab usage`.
claude -p "$card" \
  --model "$model" \
  --max-turns "$turns" \
  --permission-mode "$mode" \
  --output-format json \
  > "$LAB_CANDIDATE_DIR/session.json" 2> "$LAB_CANDIDATE_DIR/session.stderr"
rc=$?
if [ "$rc" -ne 0 ] && [ ! -s "$LAB_CANDIDATE_DIR/session.json" ]; then
  echo "lab-worker: claude exited $rc before producing a result:" >&2
  tail -5 "$LAB_CANDIDATE_DIR/session.stderr" >&2
  exit 3
fi
python3 - "$LAB_CANDIDATE_DIR/session.json" <<'PY' || true
import json, sys
try:
    r = json.load(open(sys.argv[1]))
except Exception as e:
    print(f"lab-worker: session.json unreadable: {e}"); sys.exit(0)
print(f"lab-worker: session {r.get('session_id','?')} turns={r.get('num_turns','?')} "
      f"ms={r.get('duration_ms','?')} error={r.get('is_error', False)}")
PY

# The contract, checked mechanically. A summary is owed even on failure.
unmet=()
[ -f "$LAB_CANDIDATE_DIR/code/run.sh" ]     || unmet+=("code/run.sh missing")
[ -f "$LAB_PREDICTIONS_OUT" ]               || unmet+=("$(basename "$LAB_PREDICTIONS_OUT") missing")
if [ ! -s "$LAB_CANDIDATE_DIR/summary.md" ]; then
  {
    echo "# $cid — no summary left by the worker"
    echo
    echo "Final session text (mechanically copied by lab-worker):"
    echo
    python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("result","")[:3000])' \
      "$LAB_CANDIDATE_DIR/session.json" 2>/dev/null || echo "_none_"
  } > "$LAB_CANDIDATE_DIR/summary.md"
fi
if [ "${#unmet[@]}" -gt 0 ]; then
  echo "lab-worker: contract unmet: ${unmet[*]}" >&2
  exit 2
fi
echo "lab-worker: contract met"
