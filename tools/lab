def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[valid-type]
    print(f"lab: error: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg: str) -> None:
    print(f"lab: warning: {msg}", file=sys.stderr)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def repo_root() -> Path:
    """Repo root = nearest ancestor holding PROTOCOL.md, else the git root."""
    env = os.environ.get("LAB_ROOT") or os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return Path(env).resolve()
    here = Path.cwd().resolve()
    for cand in [here, *here.parents]:
        if (cand / "PROTOCOL.md").exists() or (cand / ".git").exists():
            return cand
    return here


ROOT = repo_root()
STATE_PATH = ROOT / "state.json"
EVENTS_PATH = ROOT / "events.jsonl"
PROTOCOL_PATH = ROOT / "PROTOCOL.md"
LEDGER_PATH = ROOT / "LEDGER.md"
LAB_DIR = ROOT / ".lab"          # runtime scratch, gitignored


def write_json_atomic(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
    tmp.write_text(json.dumps(obj, indent=2, sort_keys=False) + "\n")
    os.replace(tmp, path)


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        die(f"{path.relative_to(ROOT) if path.is_relative_to(ROOT) else path} not found — run `lab init` first")
    except json.JSONDecodeError as e:
        die(f"{path.name} is not valid JSON: {e}")


def load_state() -> dict:
    return read_json(STATE_PATH)


def save_state(state: dict) -> None:
    state["format"] = FORMAT_VERSION   # always reflects the lab that last wrote it
    state["updated_at"] = now_iso()
    write_json_atomic(STATE_PATH, state)


def git(*args: str) -> str:
    try:
        out = subprocess.run(
            ["git", "-C", str(ROOT), *args],
            capture_output=True, text=True, timeout=10,
        )
        return out.stdout.strip()
    except Exception:
        return ""


def run_dir(run: int) -> Path:
    return ROOT / "runs" / f"r{run:03d}"


# ---------------------------------------------------------------------------
# Minimal YAML frontmatter parsing (scalars, one level of nesting, simple lists).
# Enough for PROTOCOL.md's fixed schema; no external dependency.
# ---------------------------------------------------------------------------

def _coerce(raw: str) -> Any:
    v = raw.strip()
    if not v:
        return ""
    # Quoted scalar: take what's inside the quotes, ignore any trailing comment.
    if v[0] in "\"'":
        close = v.find(v[0], 1)
        if close != -1:
            return v[1:close]
    # Unquoted scalar: ' #' starts a comment, as in real YAML. The shipped
    # templates annotate their frontmatter this way.
    v = re.split(r"\s+#", v, maxsplit=1)[0].strip()
    if not v:
        return ""
    low = v.lower()
    if low in ("true", "false"):
        return low == "true"
    if low in ("null", "~", "none"):
        return None
    try:
        return int(v)
    except ValueError:
        pass
    try:
        return float(v)
    except ValueError:
        pass
    return v


def parse_frontmatter(text: str) -> tuple[dict, str]:
    """Return (frontmatter dict, body). Raises ValueError on malformed input."""
    if not text.startswith("---"):
        raise ValueError("file does not start with a '---' frontmatter block")
    end = text.find("\n---", 3)
    if end == -1:
        raise ValueError("unterminated frontmatter block (missing closing '---')")
    head = text[text.find("\n") + 1:end]
    body = text[end + 4:]

    data: dict[str, Any] = {}
    parent: str | None = None
    for lineno, line in enumerate(head.splitlines(), start=2):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        stripped = line.strip()
        if stripped.startswith("- "):
            if parent is None:
                raise ValueError(f"line {lineno}: list item outside a key")
            data.setdefault(parent, [])
            if not isinstance(data[parent], list):
                data[parent] = []
            data[parent].append(_coerce(stripped[2:]))
            continue
        if ":" not in stripped:
            raise ValueError(f"line {lineno}: expected 'key: value'")
        key, _, val = stripped.partition(":")
        key = key.strip()
        if indent == 0:
            if val.strip() == "":
                data[key] = {}
                parent = key
            else:
                data[key] = _coerce(val)
                parent = None
        else:
            if parent is None:
                raise ValueError(f"line {lineno}: indented key without a parent")
            if not isinstance(data.get(parent), dict):
                data[parent] = {}
            data[parent][key] = _coerce(val)
    return data, body


def load_protocol() -> tuple[dict, str]:
    if not PROTOCOL_PATH.exists():
        die("PROTOCOL.md not found — this repo has no project yet")
    try:
        return parse_frontmatter(PROTOCOL_PATH.read_text())
    except ValueError as e:
        die(f"PROTOCOL.md frontmatter: {e}")


# ---------------------------------------------------------------------------
# Redaction
# ---------------------------------------------------------------------------

def _env_secrets() -> list[str]:
    """Literal values of env vars named in .lab-redact (one name per line)."""
    out: list[str] = []
    f = ROOT / ".lab-redact"
    if f.exists():
        for line in f.read_text().splitlines():
            name = line.split("#", 1)[0].strip()
            if not name:
                continue
            val = os.environ.get(name)
            if val and len(val) >= 6:
                out.append(val)
    return out


def redact(value: Any, secrets: list[str] | None = None) -> Any:
    """Recursively strip secret-shaped substrings from strings."""
    secrets = _env_secrets() if secrets is None else secrets
    if isinstance(value, str):
        s = value
        for lit in secrets:
            s = s.replace(lit, REDACTED)
        for pat in REDACT_PATTERNS:
            s = pat.sub(REDACTED, s)
        return s
    if isinstance(value, dict):
        return {k: redact(v, secrets) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v, secrets) for v in value]
    return value


