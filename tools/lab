# ---------------------------------------------------------------------------
# The contract: event types and their feed class, limits, the format version.
# The campaign vocabulary (operators, candidate and campaign statuses, claims)
# lives in tools/lab_campaign.py and is published through FORMAT.json from there.
# ---------------------------------------------------------------------------

# Output format version, as consumed by nullsilver.com and any other parser.
# MAJOR bumps when a consumer that ignores the change would misread the data:
# a key renamed or removed, a status renamed, an event type's feed class changed,
# a limit tightened. MINOR bumps for additive changes a consumer can safely
# ignore: a new event type, a new optional key.
#
# It is stamped into population.json, into every event as it is written, into
# each candidate's config.json and each watch entry, and published whole in
# FORMAT.json. Per-event stamping is what makes an append-only feed readable
# across upgrades: lines written by an older lab keep their old version forever,
# so a consumer never has to guess which rules applied to a given line.
#
# 2.0 removed the phase machine (phases, gates, protocol revisions, trials,
# sessions, predictions) and its state.json. 2.1 adds the optional finding cards
# (candidates/cNNNN/finding.json, population.json `memory`, job.json `findings`).
# Version history: README.md, "Format versioning".
FORMAT_VERSION = "2.1"

# Every event type carries a fixed feed class. `news` reaches the homepage and RSS,
# `activity` only the project timeline, `none` is chart data.
EVENT_FEED: dict[str, str] = {
    "campaign.start": "news",
    "campaign.stop": "news",
    "campaign.paused": "activity",
    "candidate.launch": "activity",
    "candidate.done": "activity",
    "candidate.failed": "activity",
    "metric": "none",
    "note": "activity",
    "error": "activity",
}

MSG_MAX = 140
EVENT_MAX_BYTES = 4096
METRIC_MIN_INTERVAL_SEC = 60  # per candidate

# Secret shapes that must never reach a public feed.
REDACT_PATTERNS = [
    re.compile(r"sk-[A-Za-z0-9_\-]{8,}"),
    re.compile(r"AKIA[0-9A-Z]{12,}"),
    re.compile(r"hf_[A-Za-z0-9]{8,}"),
    re.compile(r"gh[pousr]_[A-Za-z0-9]{8,}"),
    re.compile(r"github_pat_[A-Za-z0-9_]{8,}"),
    re.compile(r"(?i)bearer\s+[A-Za-z0-9._\-]{8,}"),
    re.compile(r"xox[abprs]-[A-Za-z0-9\-]{8,}"),
]
REDACTED = "[REDACTED]"


# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[valid-type]
    print(f"lab: error: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg: str) -> None:
    print(f"lab: warning: {msg}", file=sys.stderr)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def repo_root() -> Path:
    """Repo root = nearest ancestor holding campaign.toml or population.json, else
    the git root, else the working directory."""
    env = os.environ.get("LAB_ROOT") or os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return Path(env).resolve()
    here = Path.cwd().resolve()
    for cand in [here, *here.parents]:
        if (cand / "campaign.toml").exists() or (cand / "population.json").exists() \
                or (cand / ".git").exists():
            return cand
    return here


ROOT = repo_root()
EVENTS_PATH = ROOT / "events.jsonl"
LEDGER_PATH = ROOT / "LEDGER.md"
LAB_DIR = ROOT / ".lab"          # runtime scratch, gitignored


def write_json_atomic(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
    tmp.write_text(json.dumps(obj, indent=2, sort_keys=False) + "\n")
    os.replace(tmp, path)


def git(*args: str) -> str:
    try:
        out = subprocess.run(
            ["git", "-C", str(ROOT), *args],
            capture_output=True, text=True, timeout=10,
        )
        return out.stdout.strip()
    except Exception:
        return ""


# ---------------------------------------------------------------------------
# Redaction
# ---------------------------------------------------------------------------

def _env_secrets() -> list[str]:
    """Literal values of env vars named in .lab-redact (one name per line)."""
    out: list[str] = []
    f = ROOT / ".lab-redact"
    if f.exists():
        for line in f.read_text().splitlines():
            name = line.split("#", 1)[0].strip()
            if not name:
                continue
            val = os.environ.get(name)
            if val and len(val) >= 6:
                out.append(val)
    return out


def redact(value: Any, secrets: list[str] | None = None) -> Any:
    """Recursively strip secret-shaped substrings from strings."""
    secrets = _env_secrets() if secrets is None else secrets
    if isinstance(value, str):
        s = value
        for lit in secrets:
            s = s.replace(lit, REDACTED)
        for pat in REDACT_PATTERNS:
            s = pat.sub(REDACTED, s)
        return s
    if isinstance(value, dict):
        return {k: redact(v, secrets) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v, secrets) for v in value]
    return value


# ---------------------------------------------------------------------------
# Events
# ---------------------------------------------------------------------------

def append_event(event: dict) -> None:
    line = json.dumps(event, separators=(",", ":"), default=str)
    if len(line.encode()) > EVENT_MAX_BYTES:
        die(f"event is {len(line.encode())} bytes, limit is {EVENT_MAX_BYTES} "
            "— put the detail in a summary.md, not the public feed")
    EVENTS_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(EVENTS_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, (line + "\n").encode())   # single atomic append
    finally:
        os.close(fd)


def ingest_push(event: dict) -> None:
    """Best-effort realtime push to nullsilver.com. Silent on any failure:
    git is the source of truth and the site backfills on push."""
    url = os.environ.get("NULLSILVER_INGEST_URL")
    if not url:
        return
    try:
        import urllib.request
        req = urllib.request.Request(
            url,
            data=json.dumps(event, default=str).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        token = os.environ.get("NULLSILVER_TOKEN")
        if token:
            req.add_header("Authorization", f"Bearer {token}")
        urllib.request.urlopen(req, timeout=2).read(1)
    except Exception:
        pass


def _metric_throttled(key: str) -> bool:
    """True if a metric event for this key (a candidate) was emitted < 60s ago."""
    LAB_DIR.mkdir(parents=True, exist_ok=True)
    path = LAB_DIR / "metric_throttle.json"
    try:
        seen = json.loads(path.read_text())
    except Exception:
        seen = {}
    last = seen.get(key, 0)
    now = time.time()
    if now - last < METRIC_MIN_INTERVAL_SEC:
        return True
    seen[key] = now
    write_json_atomic(path, seen)
    return False


def emit(etype: str, msg: str, data: dict | None = None,
         candidate: str | None = None) -> dict | None:
    """Validate, redact and append one event. Returns the event, or None if dropped.

    Every event carries `campaign` and `candidate` at the top level (null when the
    payload names none), so a consumer can group the feed without reading `data`."""
    if etype not in EVENT_FEED:
        die(f"unknown event type '{etype}'. Known types: {', '.join(sorted(EVENT_FEED))}")

    data = dict(data or {})
    if candidate:
        data.setdefault("candidate", candidate)
    if etype == "metric":
        key = data.get("candidate") or "global"
        if _metric_throttled(str(key)):
            # Not an error: full-resolution metrics live in results.jsonl.
            warn(f"metric event throttled (<{METRIC_MIN_INTERVAL_SEC}s since last for {key})")
            return None

    msg = " ".join(str(msg).split())          # single line, collapse whitespace
    if len(msg) > MSG_MAX:
        warn(f"msg truncated to {MSG_MAX} chars (it renders in the site news column)")
        msg = msg[: MSG_MAX - 1].rstrip() + "…"

    event = {
        "format": FORMAT_VERSION,
        "ts": now_iso(),
        "type": etype,
        "campaign": data.get("campaign"),
        "candidate": data.get("candidate"),
        "msg": msg,
        "data": data,
    }
    event = redact(event)
    append_event(event)
    ingest_push(event)
    return event


