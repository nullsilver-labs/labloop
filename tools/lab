LEDGER_HEADER = """# LEDGER — every trial, ever

One row per trial. Never delete a row; a failed or killed trial is evidence.
Statuses: `running | done | killed | invalidated`.
Verdicts (against the **pre-registered** gate in the spec): `GO | NO-GO | INCONCLUSIVE`.
Rows are written by `lab trial new` / `lab trial done` — edit the note column by hand
if you must, never the rest.

| run | exp | trial | status | verdict | path | note |
|---|---|---|---|---|---|---|
"""


def ledger_upsert(trial_id: str, row: dict) -> None:
    """Insert or replace the row for trial_id, preserving file order."""
    if not LEDGER_PATH.exists():
        LEDGER_PATH.write_text(LEDGER_HEADER)
    lines = LEDGER_PATH.read_text().splitlines()
    new = "| {run} | {exp} | {trial} | {status} | {verdict} | `{path}` | {note} |".format(
        run=row.get("run", ""), exp=row.get("exp", ""), trial=trial_id,
        status=row.get("status", ""), verdict=row.get("verdict") or "",
        path=row.get("path", ""), note=(row.get("note") or "").replace("|", "/"),
    )
    for i, line in enumerate(lines):
        if line.startswith("|") and f"| {trial_id} |" in line:
            lines[i] = new
            break
    else:
        lines.append(new)
    LEDGER_PATH.write_text("\n".join(lines) + "\n")


# ---------------------------------------------------------------------------
# Environment fingerprinting (absorbed from labloop's explogger.py)
# ---------------------------------------------------------------------------

DEFAULT_PACKAGES = [
    "torch", "transformers", "numpy", "scipy", "pandas", "datasets",
    "jax", "sklearn", "scikit-learn", "accelerate", "vllm",
]


def package_versions(extra: list[str]) -> dict[str, str]:
    from importlib import metadata
    versions = {"python": platform.python_version(), "executable": sys.executable}
    for name in [*DEFAULT_PACKAGES, *extra]:
        try:
            versions[name] = metadata.version(name)
        except Exception:
            continue
    return versions


def hardware_fingerprint() -> dict:
    hw: dict[str, Any] = {
        "platform": platform.platform(),
        "machine": platform.machine(),
        "processor": platform.processor(),
        "hostname": platform.node(),
        "cpu_count": os.cpu_count(),
    }
    try:
        if sys.platform == "darwin":
            hw["cpu_model"] = subprocess.run(
                ["sysctl", "-n", "machdep.cpu.brand_string"],
                capture_output=True, text=True, timeout=5).stdout.strip()
            mem = subprocess.run(["sysctl", "-n", "hw.memsize"],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
            if mem.isdigit():
                hw["ram_gb"] = round(int(mem) / 2**30, 1)
        else:
            pages = os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")
            hw["ram_gb"] = round(pages / 2**30, 1)
    except Exception:
        pass
    try:
        smi = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"],
            capture_output=True, text=True, timeout=10)
        if smi.returncode == 0 and smi.stdout.strip():
            hw["gpus"] = [g.strip() for g in smi.stdout.strip().splitlines()]
    except Exception:
        pass
    return hw


# ---------------------------------------------------------------------------
# Model provenance — who was asked to run a session, and who actually answered.
# Two facts, kept apart on purpose, each labelled with how it was obtained.
# ---------------------------------------------------------------------------

SESSION_POINTER = LAB_DIR / "session-current"


def requested_model(phase: str | None = None) -> dict[str, str]:
    """What the launcher asked for — and how sure we are of the answer.

    The launchers (`loop.sh`, `/orchestrate`) export `LAB_MODEL` alongside
    `claude --model`, so the value travels with the session that actually ran;
    `requested_source: env` marks that record. Falling back to `.claude/loop.conf`
    reads the file as it is *now* — current config, not history — so it is
    labelled `conf`, a guess a reader must never mistake for the record.
    """
    env = os.environ.get("LAB_MODEL", "").strip()
    if env:
        return {"requested": env, "requested_source": "env"}
    conf = load_conf(required=False) or {}
    if phase and conf.get(phase):
        return {"requested": conf[phase], "requested_source": "conf"}
    return {"requested": "unknown", "requested_source": "none"}


def session_transcript() -> Path | None:
    """The transcript of the session driving this process, if a hook recorded it.

    The SessionStart hook writes `.lab/session-current` (the session id) and a
    record in `.lab/sessions/<sid>.json` carrying `transcript_path`; the Stop
    hook clears the pointer. No pointer — a human running `lab` by hand — means
    no transcript, and served-model provenance honestly reports `none`.
    """
    try:
        sid = SESSION_POINTER.read_text().strip()
        rec = json.loads((LAB_DIR / "sessions" / f"{sid}.json").read_text())
        path = Path(rec["transcript_path"])
        return path if path.is_file() else None
    except Exception:
        return None


def served_models(transcript: Path | None) -> list[str]:
    """Models that actually answered, in order of first appearance.

    Read from the Claude Code session transcript — the ground truth that
    survives `--fallback-model`, usage-limit downgrades and mid-session
    switches, none of which the `--model` flag (or LAB_MODEL) can see. More
    than one entry means the session changed model partway through.
    """
    if transcript is None:
        return []
    out: list[str] = []
    try:
        with open(transcript) as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if entry.get("type") != "assistant":
                    continue
                model = (entry.get("message") or {}).get("model")
                if model and model != "<synthetic>" and model not in out:
                    out.append(model)
    except OSError:
        return []
    return out


def agent_record(phase: str | None = None) -> dict[str, Any]:
    """The full who-ran-this record: requested and served, with their sources."""
    rec: dict[str, Any] = requested_model(phase)
    served = served_models(session_transcript())
    rec["served"] = served
    rec["served_source"] = "transcript" if served else "none"
    return rec


def run_models(run: Any) -> dict[str, Any]:
    """Which models drove a run, rolled up from the feed so the site never scans it.

    `session.start` events record what was requested; `session.end` events
    record what the transcript says was served. Per phase, served supersedes
    requested — the transcript outranks the flag — and requested only fills
    phases whose sessions left no transcript record. `by_phase` values are
    ordered lists: a list longer than one is a fallback or a mid-session
    switch, made visible instead of silent. `sources` is the distinct
    provenance values the rollup is built from — within {transcript, env} it
    is a record; any `conf` or `none` means partly reconstructed.
    """
    out: dict[str, Any] = {"started_with": None, "by_phase": {}, "sources": []}
    if run is None or not EVENTS_PATH.exists():
        return out

    requested: dict[str, list[str]] = {}       # phase -> models, by first appearance
    req_sources: dict[str, set[str]] = {}
    served: dict[str, list[str]] = {}
    order: list[str] = []                      # phases in first-seen order

    for line in EVENTS_PATH.read_text().splitlines():
        if not line.strip():
            continue
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            continue
        if e.get("run") != run:
            continue
        d = e.get("data") or {}
        if e.get("type") == "session.start":
            phase, model = e.get("phase"), d.get("requested")
            if phase and model and model != "unknown":
                if phase not in order:
                    order.append(phase)
                bucket = requested.setdefault(phase, [])
                if model not in bucket:
                    bucket.append(model)
                req_sources.setdefault(phase, set()).add(
                    d.get("requested_source", "none"))
        elif e.get("type") == "session.end":
            # A session ends *after* transitioning, so the event's own `phase`
            # may already be the next one; `phase_ran` is the session's truth.
            phase, models = d.get("phase_ran") or e.get("phase"), d.get("served") or []
            if phase and models:
                if phase not in order:
                    order.append(phase)
                bucket = served.setdefault(phase, [])
                for m in models:
                    if m not in bucket:
                        bucket.append(m)

    sources: set[str] = set()
    for phase in order:
        if phase in served:
            out["by_phase"][phase] = served[phase]
            sources.add("transcript")
        else:
            out["by_phase"][phase] = requested[phase]
            sources |= req_sources[phase]
    for phase in order:
        if out["by_phase"].get(phase):
            out["started_with"] = out["by_phase"][phase][0]
            break
    out["sources"] = sorted(sources)
    return out


