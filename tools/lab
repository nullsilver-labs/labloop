LEDGER_HEADER = """# LEDGER — every candidate, ever

One row per candidate. Never delete a row; a failed, invalid, killed or deferred
candidate is evidence. Statuses: `running | done | failed | killed | invalid | deferred`.
The claim column is filled once, for the frozen candidate, from the final split.
Rows are written by `lab run` — edit the note column by hand if you must, never the rest.

| campaign | operator | candidate | status | claim | path | note |
|---|---|---|---|---|---|---|
"""


def ledger_upsert(candidate_id: str, row: dict) -> None:
    """Insert or replace the row for candidate_id, preserving file order.
    Row keys: run (campaign id), exp (operator), status, verdict (claim), path, note."""
    if not LEDGER_PATH.exists():
        LEDGER_PATH.write_text(LEDGER_HEADER)
    lines = LEDGER_PATH.read_text().splitlines()
    new = "| {run} | {exp} | {trial} | {status} | {verdict} | `{path}` | {note} |".format(
        run=row.get("run", ""), exp=row.get("exp", ""), trial=candidate_id,
        status=row.get("status", ""), verdict=row.get("verdict") or "",
        path=row.get("path", ""), note=(row.get("note") or "").replace("|", "/"),
    )
    for i, line in enumerate(lines):
        if line.startswith("|") and f"| {candidate_id} |" in line:
            lines[i] = new
            break
    else:
        lines.append(new)
    LEDGER_PATH.write_text("\n".join(lines) + "\n")


