def cmd_init(args) -> None:
    fm, body = load_protocol()
    if PLACEHOLDER in PROTOCOL_PATH.read_text():
        die("PROTOCOL.md still contains REPLACE-ME placeholders — the human writes "
            "revision 1 before the lab starts (see README.md)")
    missing = [k for k in PROTOCOL_REQUIRED_KEYS if k not in fm]
    if missing:
        die(f"PROTOCOL.md frontmatter is missing: {', '.join(missing)}")
    if STATE_PATH.exists() and not args.force:
        die("state.json already exists (use --force only on a fresh clone)")

    state = {
        "project": fm["id"],
        "kind": fm.get("kind", "research"),
        "phase": "init",
        "run": 1,
        "revision": int(fm.get("revision", 1)),
        "status": "running",
        "active_trials": [],
        "awaiting": None,
        "updated_at": now_iso(),
    }
    write_json_atomic(STATE_PATH, state)
    EVENTS_PATH.touch()
    (ROOT / "protocol").mkdir(exist_ok=True)
    run_dir(1).joinpath("specs").mkdir(parents=True, exist_ok=True)
    run_dir(1).joinpath("trials").mkdir(parents=True, exist_ok=True)
    if not LEDGER_PATH.exists():
        LEDGER_PATH.write_text(LEDGER_HEADER)
    if not (ROOT / "NOTES.md").exists():
        (ROOT / "NOTES.md").write_text(
            "# NOTES — lab notebook\n\nNewest entries at the bottom. This is where the "
            "*thinking* lives: predictions with confidence, interpretations, surprises,\n"
            "failed ideas and why they failed, literature pointers. LEDGER holds the "
            "facts; when the two disagree, LEDGER wins.\n")
    if not (ROOT / "HANDOFF.md").exists():
        (ROOT / "HANDOFF.md").write_text(
            "# HANDOFF\n\n## Just happened\n\nProject initialized; no phase has run yet.\n\n"
            "## State of the run\n\nRun 1, revision 1, phase `init`.\n\n"
            "## Next phase should\n\nCompile PROTOCOL.md into plan.json and the specs.\n\n"
            "## Open questions / risks\n\nNone yet.\n\n## For the human\n\nNothing pending.\n")

    # Freeze revision 1 so the diff viewer has a baseline.
    frozen = ROOT / "protocol" / f"rev{int(fm.get('revision', 1)):03d}.md"
    if not frozen.exists():
        shutil.copyfile(PROTOCOL_PATH, frozen)

    emit("project.created", f"{fm['id']} initialized: {fm['title']}",
         {"kind": state["kind"], "revision": state["revision"]}, state=state)
    print(f"initialized {fm['id']} — phase=init run=1 revision={state['revision']}")


def cmd_log(args) -> None:
    data = {}
    if args.data:
        try:
            data = json.loads(args.data)
        except json.JSONDecodeError as e:
            die(f"--data is not valid JSON: {e}")
        if not isinstance(data, dict):
            die("--data must be a JSON object")
    ev = emit(args.type, args.msg, data, trial=args.trial)
    if ev is None:
        sys.exit(0)
    print(json.dumps(ev, separators=(",", ":")))


def cmd_events(args) -> None:
    if not EVENTS_PATH.exists():
        return
    lines = [l for l in EVENTS_PATH.read_text().splitlines() if l.strip()]
    if args.feed_class:
        keep = []
        for l in lines:
            try:
                if EVENT_FEED.get(json.loads(l).get("type")) == args.feed_class:
                    keep.append(l)
            except json.JSONDecodeError:
                continue
        lines = keep
    for l in lines[-args.n:]:
        print(l)


def cmd_state_get(args) -> None:
    state = load_state()
    if args.key:
        if args.key not in state:
            die(f"no such key '{args.key}' in state.json")
        v = state[args.key]
        # Scalars print bare (shell-friendly); everything else prints as JSON,
        # so `null` reads as null and not as Python's None.
        print(v if isinstance(v, str) else json.dumps(v))
    else:
        print(json.dumps(state, indent=2))


def cmd_state_set(args) -> None:
    state = load_state()
    for assignment in args.assignments:
        if "=" not in assignment:
            die(f"expected key=value, got '{assignment}'")
        key, _, val = assignment.partition("=")
        key, val = key.strip(), val.strip()

        if key == "phase":
            _set_phase(state, val)
        elif key == "status":
            _set_status(state, val)
        else:
            die(f"'{key}' is not settable by hand. phase and status are; run and "
                "revision move only via `lab state set phase=init` (from decide) and "
                "`lab protocol activate`.")
    save_state(state)
    print(json.dumps({k: state[k] for k in ("phase", "run", "revision", "status")}))


def _set_phase(state: dict, target: str) -> None:
    cur = state["phase"]
    if target not in PHASES:
        die(f"'{target}' is not a phase. Phases: {', '.join(PHASES)}")
    if state["status"] == "concluded":
        die("project is concluded — no further transitions")
    if state["status"] == "awaiting_gate":
        die("a gate is open (see state.awaiting) — resolve it with `lab gate resolve` "
            "before transitioning")
    allowed = TRANSITIONS[cur]
    if target not in allowed:
        die(f"illegal transition {cur} -> {target}. Legal from {cur}: "
            f"{', '.join(allowed) if allowed else '(terminal)'}")
    if state.get("active_trials"):
        die(f"{len(state['active_trials'])} trial(s) still open: "
            f"{', '.join(state['active_trials'])} — close them with `lab trial done` first")

    emit("phase.exit", f"exit {cur}", {"from": cur, "to": target}, state=state)
    state["phase"] = target
    if cur == "decide" and target == "init":
        state["run"] = int(state["run"]) + 1
        rd = run_dir(state["run"])
        (rd / "specs").mkdir(parents=True, exist_ok=True)
        (rd / "trials").mkdir(parents=True, exist_ok=True)
    state["updated_at"] = now_iso()
    emit("phase.enter", f"enter {target} (run {state['run']})",
         {"from": cur, "to": target}, state=state)


def _set_status(state: dict, target: str) -> None:
    if target not in STATUSES:
        die(f"'{target}' is not a status. Statuses: {', '.join(STATUSES)}")
    if target == "awaiting_gate":
        die("raise gates with `lab gate request` so the question is recorded")
    if target == "concluded":
        if state["phase"] != "conclude":
            die("status=concluded is only legal from phase=conclude")
        state["status"] = "concluded"
        state["awaiting"] = None
        emit("project.concluded", "project concluded", {"runs": state["run"]}, state=state)
        return
    if state["status"] == "concluded":
        die("project is concluded — reopening needs a human editing state.json by hand")
    if state["status"] == "awaiting_gate" and target != "running":
        die("resolve the open gate with `lab gate resolve` instead")
    state["status"] = target


def cmd_trial_new(args) -> None:
    state = load_state()
    if state["status"] == "concluded":
        die("project is concluded")
    if state["phase"] not in ("build", "pilot", "execute"):
        die(f"trials may only be launched in build/pilot/execute (phase is {state['phase']})")

    rd = run_dir(state["run"]) / "trials"
    rd.mkdir(parents=True, exist_ok=True)
    while True:
        trial_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M") + "-" + uuid.uuid4().hex[:4]
        tdir = rd / trial_id
        try:
            tdir.mkdir(exist_ok=False)   # collision-proof by construction
            break
        except FileExistsError:
            continue

    config: dict[str, Any] = {}
    if args.config:
        raw = args.config
        if raw.startswith("@"):
            raw = Path(raw[1:]).read_text()
        try:
            config = json.loads(raw)
        except json.JSONDecodeError as e:
            die(f"--config is not valid JSON: {e}")

    seed = args.seed if args.seed is not None else config.get("seed")
    if seed is None:
        seed = int(hashlib.sha256(trial_id.encode()).hexdigest()[:8], 16) % (2**31)
        warn(f"no --seed given; derived seed {seed} from the trial id and recorded it")
    config["seed"] = seed

    snapshot = {
        "trial_id": trial_id,
        "exp_id": args.exp_id,
        "run": state["run"],
        "revision": state["revision"],
        "phase": state["phase"],
        "spec": args.spec or "",
        "start_time": now_iso(),
        "seed": seed,
        "command": args.command or "",
        "argv": sys.argv,
        "cwd": str(Path.cwd()),
        "git_commit": git("rev-parse", "--short", "HEAD") or "no-git",
        "git_dirty": bool(git("status", "--porcelain")),
        "hardware": hardware_fingerprint(),
        "packages": package_versions(args.packages.split(",") if args.packages else []),
        "config": config,
    }
    write_json_atomic(tdir / "config.json", snapshot)
    (tdir / "results.jsonl").touch()
    (tdir / "console.log").touch()

    state.setdefault("active_trials", []).append(trial_id)
    save_state(state)
    rel = str(tdir.relative_to(ROOT))
    ledger_upsert(trial_id, {"run": state["run"], "exp": args.exp_id, "status": "running",
                             "verdict": "", "path": rel, "note": args.note or ""})
    emit("trial.launch", args.note or f"{args.exp_id} trial launched",
         {"exp": args.exp_id, "spec": args.spec or ""}, state=state, trial=trial_id)
    print(rel)


def cmd_trial_log(args) -> None:
    tdir = Path(args.dir)
    if not tdir.is_absolute():
        tdir = ROOT / tdir
    if not (tdir / "config.json").exists():
        die(f"{args.dir} is not a trial dir")
    try:
        rec = json.loads(args.data)
    except json.JSONDecodeError as e:
        die(f"--data is not valid JSON: {e}")
    if not isinstance(rec, dict):
        die("--data must be a JSON object")
    rec.setdefault("ts", now_iso())
    with open(tdir / "results.jsonl", "a") as f:
        f.write(json.dumps(rec, default=str) + "\n")
    if args.metric_msg:
        emit("metric", args.metric_msg, rec, trial=tdir.name)


def cmd_trial_done(args) -> None:
    state = load_state()
    tdir = Path(args.dir)
    if not tdir.is_absolute():
        tdir = ROOT / tdir
    if not (tdir / "config.json").exists():
        die(f"{args.dir} is not a trial dir")
    trial_id = tdir.name
    summary = tdir / "summary.md"
    if not summary.exists() or not summary.read_text().strip():
        die(f"{args.dir}/summary.md is missing or empty. Every trial gets a summary — "
            "a killed one says so and why (templates/trial-summary.md)")
    if args.verdict and args.verdict not in VERDICTS:
        die(f"verdict must be one of {', '.join(VERDICTS)}")
    if args.killed and not args.reason:
        die("--killed requires --reason")

    cfg = json.loads((tdir / "config.json").read_text())
    cfg["ended_at"] = now_iso()
    cfg["outcome"] = "killed" if args.killed else "done"
    if args.killed:
        cfg["kill_reason"] = args.reason
    write_json_atomic(tdir / "config.json", cfg)

    state["active_trials"] = [t for t in state.get("active_trials", []) if t != trial_id]
    save_state(state)

    rel = str(tdir.relative_to(ROOT))
    ledger_upsert(trial_id, {
        "run": cfg.get("run", state["run"]), "exp": cfg.get("exp_id", ""),
        "status": "killed" if args.killed else "done",
        "verdict": args.verdict or "", "path": rel,
        "note": args.note or (args.reason if args.killed else ""),
    })
    if args.killed:
        emit("kill", f"{cfg.get('exp_id','trial')} killed: {args.reason}",
             {"exp": cfg.get("exp_id", ""), "reason": args.reason}, state=state, trial=trial_id)
    emit("trial.done",
         args.note or (f"{cfg.get('exp_id','trial')} "
                       f"{'killed' if args.killed else 'finished'}"
                       f"{': ' + args.verdict if args.verdict else ''}"),
         {"exp": cfg.get("exp_id", ""), "verdict": args.verdict or None,
          "killed": bool(args.killed)}, state=state, trial=trial_id)
    print(rel)


def cmd_protocol_freeze(args) -> None:
    fm, _ = load_protocol()
    rev = int(fm["revision"])
    dest = ROOT / "protocol" / f"rev{rev:03d}.md"
    dest.parent.mkdir(exist_ok=True)
    if dest.exists():
        existing = dest.read_text()
        if existing == PROTOCOL_PATH.read_text():
            print(f"{dest.relative_to(ROOT)} (already frozen, identical)")
            return
        die(f"{dest.relative_to(ROOT)} already exists and differs — frozen revisions "
            "are evidence. Bump `revision` in PROTOCOL.md before freezing again.")
    shutil.copyfile(PROTOCOL_PATH, dest)
    print(str(dest.relative_to(ROOT)))


def cmd_protocol_activate(args) -> None:
    state = load_state()
    fm, body = load_protocol()
    new_rev = int(fm["revision"])
    old_rev = int(state["revision"])
    if new_rev != old_rev + 1:
        die(f"PROTOCOL.md says revision {new_rev}, state says {old_rev} — a revision "
            "bumps by exactly 1 and only in the decide phase")
    frozen = ROOT / "protocol" / f"rev{old_rev:03d}.md"
    if not frozen.exists():
        die(f"revision {old_rev} was never frozen — run `lab protocol freeze` on the "
            "old text before editing PROTOCOL.md")
    if f"rev{new_rev}" not in body and f"revision {new_rev}" not in body.lower():
        die(f"the Changelog has no entry for revision {new_rev} — every revision "
            "records what changed and which result motivated it")
    shutil.copyfile(PROTOCOL_PATH, ROOT / "protocol" / f"rev{new_rev:03d}.md")
    state["revision"] = new_rev
    save_state(state)
    emit("protocol.revised", args.diff_summary or f"protocol revised to rev {new_rev}",
         {"revision": new_rev, "from": old_rev,
          "diff_summary": args.diff_summary or ""}, state=state)
    print(f"revision {old_rev} -> {new_rev}")


def cmd_gate_request(args) -> None:
    state = load_state()
    if state["status"] == "awaiting_gate":
        die(f"a gate is already open: {state['awaiting'].get('question')}")
    if state["status"] == "concluded":
        die("project is concluded")
    state["status"] = "awaiting_gate"
    state["awaiting"] = {"type": args.type, "question": args.question, "since": now_iso()}
    save_state(state)
    emit("gate.requested", args.question, {"gate_type": args.type}, state=state)
    print(f"awaiting_gate: {args.question}")


def cmd_gate_resolve(args) -> None:
    state = load_state()
    if state["status"] != "awaiting_gate" or not state.get("awaiting"):
        die("no gate is open")
    gate = state["awaiting"]
    decision = "approved" if args.approve else "rejected"
    state["awaiting"] = None
    state["status"] = "running"
    save_state(state)
    emit("gate.resolved", f"{gate.get('type', 'gate')} {decision}"
                          + (f": {args.note}" if args.note else ""),
         {"gate_type": gate.get("type"), "question": gate.get("question"),
          "decision": decision, "note": args.note or ""}, state=state)
    print(f"{decision}; status=running, phase={state['phase']}")


# ---------------------------------------------------------------------------
# validate
# ---------------------------------------------------------------------------

def cmd_validate(args) -> None:
    errors: list[str] = []
    notes: list[str] = []

    def err(msg: str) -> None:
        errors.append(msg)

    # --- PROTOCOL.md -------------------------------------------------------
    fm: dict = {}
    if not PROTOCOL_PATH.exists():
        err("PROTOCOL.md is missing")
    else:
        text = PROTOCOL_PATH.read_text()
        try:
            fm, body = parse_frontmatter(text)
            for k in PROTOCOL_REQUIRED_KEYS:
                if k not in fm:
                    err(f"PROTOCOL.md frontmatter missing key '{k}'")
            if fm.get("kind") not in ("research", "artifact", "writing"):
                err(f"PROTOCOL.md kind='{fm.get('kind')}' is not a known project kind")
            if fm.get("status") not in ("active", "concluded"):
                err(f"PROTOCOL.md status='{fm.get('status')}' must be active|concluded")
            if fm.get("autonomy") not in ("gated", "auto"):
                err(f"PROTOCOL.md autonomy='{fm.get('autonomy')}' must be gated|auto")
            if not isinstance(fm.get("revision"), int):
                err("PROTOCOL.md revision must be an integer")
            if not isinstance(fm.get("budgets"), dict):
                err("PROTOCOL.md budgets must be a mapping")
            for section in PROTOCOL_SECTIONS:
                if not re.search(rf"^#+\s+{re.escape(section)}\s*$", body,
                                 re.MULTILINE | re.IGNORECASE):
                    err(f"PROTOCOL.md is missing the required section '{section}'")
            if PLACEHOLDER in text:
                err("PROTOCOL.md still contains REPLACE-ME placeholders")
        except ValueError as e:
            err(f"PROTOCOL.md frontmatter: {e}")

    # --- state.json --------------------------------------------------------
    state: dict = {}
    if not STATE_PATH.exists():
        err("state.json is missing — run `lab init`")
    else:
        try:
            state = json.loads(STATE_PATH.read_text())
        except json.JSONDecodeError as e:
            err(f"state.json is not valid JSON: {e}")
        if state:
            for k in ("project", "kind", "phase", "run", "revision", "status",
                      "active_trials", "awaiting", "updated_at"):
                if k not in state:
                    err(f"state.json missing key '{k}'")
            if state.get("phase") not in PHASES:
                err(f"state.json phase='{state.get('phase')}' is not a legal phase")
            if state.get("status") not in STATUSES:
                err(f"state.json status='{state.get('status')}' is not a legal status")
            if not isinstance(state.get("active_trials"), list):
                err("state.json active_trials must be a list")
            aw = state.get("awaiting")
            if aw is not None:
                if not isinstance(aw, dict) or not {"type", "question", "since"} <= set(aw):
                    err("state.json awaiting must be null or {type, question, since}")
                if state.get("status") != "awaiting_gate":
                    err("state.json has an open `awaiting` but status is not awaiting_gate")
            elif state.get("status") == "awaiting_gate":
                err("state.json status=awaiting_gate but `awaiting` is null")
            if fm and state.get("revision") != fm.get("revision"):
                err(f"state.json revision={state.get('revision')} disagrees with "
                    f"PROTOCOL.md revision={fm.get('revision')}")
            if fm and state.get("project") != fm.get("id"):
                err(f"state.json project={state.get('project')} disagrees with "
                    f"PROTOCOL.md id={fm.get('id')}")

    # --- events.jsonl ------------------------------------------------------
    if not EVENTS_PATH.exists():
        err("events.jsonl is missing — run `lab init`")
    else:
        for i, line in enumerate(EVENTS_PATH.read_text().splitlines(), start=1):
            if not line.strip():
                continue
            if len(line.encode()) > EVENT_MAX_BYTES:
                err(f"events.jsonl:{i} exceeds {EVENT_MAX_BYTES} bytes")
            try:
                ev = json.loads(line)
            except json.JSONDecodeError as e:
                err(f"events.jsonl:{i} is not valid JSON: {e}")
                continue
            if ev.get("type") not in EVENT_FEED:
                err(f"events.jsonl:{i} unknown event type '{ev.get('type')}'")
            for k in ("ts", "type", "msg"):
                if k not in ev:
                    err(f"events.jsonl:{i} missing key '{k}'")
            msg = ev.get("msg", "")
            if len(msg) > MSG_MAX:
                err(f"events.jsonl:{i} msg is {len(msg)} chars (max {MSG_MAX})")
            if "\n" in msg:
                err(f"events.jsonl:{i} msg contains a newline")

    # every known type must have a feed class (acceptance §14.4)
    for t in EVENT_FEED:
        if EVENT_FEED[t] not in ("news", "activity", "none"):
            err(f"event type '{t}' has no valid feed class")

    # --- trial dirs --------------------------------------------------------
    active = set(state.get("active_trials") or [])
    for tdir in sorted((ROOT / "runs").glob("r*/trials/*")):
        if not tdir.is_dir():
            continue
        rel = tdir.relative_to(ROOT)
        for required in ("config.json", "results.jsonl"):
            if not (tdir / required).exists():
                err(f"{rel} is missing {required}")
        if not (tdir / "summary.md").exists():
            if tdir.name in active:
                notes.append(f"{rel}: running, summary.md pending")
            else:
                err(f"{rel} is missing summary.md (closed trials must be summarized)")
        cfgp = tdir / "config.json"
        if cfgp.exists():
            try:
                cfg = json.loads(cfgp.read_text())
                for k in ("trial_id", "seed", "git_commit", "start_time", "hardware", "packages"):
                    if k not in cfg:
                        err(f"{rel}/config.json missing '{k}'")
            except json.JSONDecodeError as e:
                err(f"{rel}/config.json is not valid JSON: {e}")

    # --- plan.json ---------------------------------------------------------
    planp = ROOT / "plan.json"
    if planp.exists():
        try:
            plan = json.loads(planp.read_text())
            if not isinstance(plan.get("experiments"), list) or not plan["experiments"]:
                err("plan.json has no experiments")
            for e in plan.get("experiments", []):
                for k in ("id", "hypothesis", "primary_metric", "gate", "baselines",
                          "kill_criteria", "budget"):
                    if k not in e:
                        err(f"plan.json experiment '{e.get('id','?')}' missing '{k}'")
                gate = e.get("gate") or {}
                if not isinstance(gate, dict) or "value" not in gate or "direction" not in gate:
                    err(f"plan.json experiment '{e.get('id','?')}' gate needs a numeric "
                        "value and a direction")
                elif not isinstance(gate["value"], (int, float)):
                    err(f"plan.json experiment '{e.get('id','?')}' gate.value is not numeric")
                if e.get("spec") and not (ROOT / e["spec"]).exists():
                    err(f"plan.json experiment '{e.get('id','?')}' spec {e['spec']} not found")
        except json.JSONDecodeError as e:
            err(f"plan.json is not valid JSON: {e}")

    # --- .claude/loop.conf -------------------------------------------------
    conf = load_conf(required=False)
    if conf is None:
        err(".claude/loop.conf is missing")
    else:
        for phase in PHASES:
            if not conf.get(phase):
                err(f".claude/loop.conf has no model for phase '{phase}'")
        if not conf.get("orchestrator"):
            err(".claude/loop.conf has no orchestrator= model (attended mode)")
        if conf.get("permission_mode") not in ("auto", "bypassPermissions"):
            err(".claude/loop.conf permission_mode must be auto|bypassPermissions")
        for phase in PHASES:
            p = ROOT / ".claude" / "prompts" / f"{phase}.md"
            if not p.exists():
                err(f"missing phase prompt .claude/prompts/{phase}.md")

    for n in notes:
        print(f"note: {n}")
    if errors:
        for e in errors:
            print(f"FAIL: {e}", file=sys.stderr)
        print(f"\nlab validate: {len(errors)} problem(s)", file=sys.stderr)
        sys.exit(1)
    print("lab validate: OK" + (f" ({len(notes)} note(s))" if notes else ""))


def load_conf(required: bool = True) -> dict[str, str] | None:
    path = ROOT / ".claude" / "loop.conf"
    if not path.exists():
        if required:
            die(".claude/loop.conf not found")
        return None
    conf: dict[str, str] = {}
    for line in path.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        k, _, v = line.partition("=")
        conf[k.strip()] = v.strip()
    return conf


def cmd_conf(args) -> None:
    conf = load_conf() or {}
    if args.key:
        print(conf.get(args.key, ""))
    else:
        for k, v in conf.items():
            print(f"{k}={v}")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main(argv: list[str] | None = None) -> None:
    p = argparse.ArgumentParser(prog="lab", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("init", help="bootstrap the repo from PROTOCOL.md")
    sp.add_argument("--force", action="store_true")
    sp.set_defaults(func=cmd_init)

    sp = sub.add_parser("log", help="append an event to the public feed")
    sp.add_argument("type", help=f"one of: {', '.join(sorted(EVENT_FEED))}")
    sp.add_argument("--msg", required=True, help=f"<= {MSG_MAX} chars, one line")
    sp.add_argument("--data", help="JSON object with the structured payload")
    sp.add_argument("--trial", help="trial id (required for metric throttling)")
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("events", help="read the event feed")
    sp.add_argument("action", choices=["tail"])
    sp.add_argument("-n", type=int, default=20)
    sp.add_argument("--class", dest="feed_class", choices=["news", "activity", "none"])
    sp.set_defaults(func=cmd_events)

    sp = sub.add_parser("state", help="read/write state.json")
    ssub = sp.add_subparsers(dest="state_cmd", required=True)
    g = ssub.add_parser("get")
    g.add_argument("key", nargs="?")
    g.set_defaults(func=cmd_state_get)
    s = ssub.add_parser("set")
    s.add_argument("assignments", nargs="+", metavar="key=value")
    s.set_defaults(func=cmd_state_set)

    sp = sub.add_parser("trial", help="trial dirs — the run-dir contract")
    tsub = sp.add_subparsers(dest="trial_cmd", required=True)
    t = tsub.add_parser("new")
    t.add_argument("exp_id")
    t.add_argument("--config", help="JSON object, or @path/to/config.json")
    t.add_argument("--seed", type=int)
    t.add_argument("--command", help="the exact command line being run")
    t.add_argument("--spec", help="path to the experiment spec")
    t.add_argument("--packages", help="extra comma-separated packages to fingerprint")
    t.add_argument("--note", help="one-line ledger note / launch message")
    t.set_defaults(func=cmd_trial_new)
    t = tsub.add_parser("log")
    t.add_argument("dir")
    t.add_argument("--data", required=True, help="JSON object appended to results.jsonl")
    t.add_argument("--metric-msg", help="also emit a (throttled) metric event")
    t.set_defaults(func=cmd_trial_log)
    t = tsub.add_parser("done")
    t.add_argument("dir")
    t.add_argument("--verdict", help="|".join(VERDICTS))
    t.add_argument("--killed", action="store_true")
    t.add_argument("--reason", help="why it was killed")
    t.add_argument("--note", help="one-line ledger note / event message")
    t.set_defaults(func=cmd_trial_done)

    sp = sub.add_parser("protocol", help="revision mechanism")
    psub = sp.add_subparsers(dest="protocol_cmd", required=True)
    f = psub.add_parser("freeze")
    f.set_defaults(func=cmd_protocol_freeze)
    a = psub.add_parser("activate")
    a.add_argument("--diff-summary", help="one line: what changed and why")
    a.set_defaults(func=cmd_protocol_activate)

    sp = sub.add_parser("gate", help="human checkpoints")
    gsub = sp.add_subparsers(dest="gate_cmd", required=True)
    r = gsub.add_parser("request")
    r.add_argument("--type", required=True,
                   help="revision_approval | conclude_approval | question | blocked | stalled")
    r.add_argument("--question", required=True)
    r.set_defaults(func=cmd_gate_request)
    v = gsub.add_parser("resolve")
    mx = v.add_mutually_exclusive_group(required=True)
    mx.add_argument("--approve", action="store_true")
    mx.add_argument("--reject", action="store_true")
    v.add_argument("--note")
    v.set_defaults(func=cmd_gate_resolve)

    sp = sub.add_parser("validate", help="lint the repo against the contract")
    sp.set_defaults(func=cmd_validate)

    sp = sub.add_parser("conf", help="read .claude/loop.conf")
    sp.add_argument("key", nargs="?")
    sp.set_defaults(func=cmd_conf)

    args = p.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
