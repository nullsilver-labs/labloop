# ---------------------------------------------------------------------------
# The contract: phases, transitions, statuses, event types and their feed class.
# ---------------------------------------------------------------------------

PHASES = ["init", "build", "pilot", "execute", "analyze", "decide", "conclude"]

# phase -> the phases it may legally exit to (see CLAUDE.md / the state machine)
TRANSITIONS: dict[str, list[str]] = {
    "init": ["build"],
    "build": ["pilot"],
    "pilot": ["execute", "build"],      # back to build if measurement is broken
    "execute": ["analyze"],
    "analyze": ["decide"],
    "decide": ["init", "conclude"],     # init starts run N+1
    "conclude": [],                     # terminal
}

STATUSES = ["running", "awaiting_gate", "idle", "concluded"]

VERDICTS = ["GO", "NO-GO", "INCONCLUSIVE"]

# Every event type carries a fixed feed class. `news` reaches the homepage and RSS,
# `activity` only the project timeline, `none` is chart data.
EVENT_FEED: dict[str, str] = {
    "project.created": "news",
    "session.start": "activity",
    "session.end": "activity",
    "phase.enter": "activity",
    "phase.exit": "activity",
    "protocol.revised": "news",
    "prediction": "activity",
    "trial.launch": "activity",
    "trial.done": "activity",
    "metric": "none",
    "run.done": "news",
    "surprise": "activity",
    "kill": "activity",
    "error": "activity",
    "gate.requested": "activity",
    "gate.resolved": "activity",
    "gate.overridden": "activity",
    "project.concluded": "news",
}

MSG_MAX = 140
EVENT_MAX_BYTES = 4096
METRIC_MIN_INTERVAL_SEC = 60  # per trial

PROTOCOL_REQUIRED_KEYS = [
    "id", "title", "kind", "revision", "status", "autonomy", "budgets",
    "created", "updated",
]
PROTOCOL_SECTIONS = [
    "Idea", "Questions", "Hypotheses", "Success criteria", "Prior & related work",
    "Experiment sketch", "Guardrails", "Out of scope", "Changelog",
]

PLACEHOLDER = "REPLACE-ME"

# Secret shapes that must never reach a public feed.
REDACT_PATTERNS = [
    re.compile(r"sk-[A-Za-z0-9_\-]{8,}"),
    re.compile(r"AKIA[0-9A-Z]{12,}"),
    re.compile(r"hf_[A-Za-z0-9]{8,}"),
    re.compile(r"gh[pousr]_[A-Za-z0-9]{8,}"),
    re.compile(r"github_pat_[A-Za-z0-9_]{8,}"),
    re.compile(r"(?i)bearer\s+[A-Za-z0-9._\-]{8,}"),
    re.compile(r"xox[abprs]-[A-Za-z0-9\-]{8,}"),
]
REDACTED = "[REDACTED]"


# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[valid-type]
    print(f"lab: error: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg: str) -> None:
    print(f"lab: warning: {msg}", file=sys.stderr)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def repo_root() -> Path:
    """Repo root = nearest ancestor holding PROTOCOL.md, else the git root."""
    env = os.environ.get("LAB_ROOT") or os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return Path(env).resolve()
    here = Path.cwd().resolve()
    for cand in [here, *here.parents]:
        if (cand / "PROTOCOL.md").exists() or (cand / ".git").exists():
            return cand
    return here


ROOT = repo_root()
STATE_PATH = ROOT / "state.json"
EVENTS_PATH = ROOT / "events.jsonl"
PROTOCOL_PATH = ROOT / "PROTOCOL.md"
LEDGER_PATH = ROOT / "LEDGER.md"
LAB_DIR = ROOT / ".lab"          # runtime scratch, gitignored


def write_json_atomic(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
    tmp.write_text(json.dumps(obj, indent=2, sort_keys=False) + "\n")
    os.replace(tmp, path)


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        die(f"{path.relative_to(ROOT) if path.is_relative_to(ROOT) else path} not found — run `lab init` first")
    except json.JSONDecodeError as e:
        die(f"{path.name} is not valid JSON: {e}")


def load_state() -> dict:
    return read_json(STATE_PATH)


def save_state(state: dict) -> None:
    state["updated_at"] = now_iso()
    write_json_atomic(STATE_PATH, state)


def git(*args: str) -> str:
    try:
        out = subprocess.run(
            ["git", "-C", str(ROOT), *args],
            capture_output=True, text=True, timeout=10,
        )
        return out.stdout.strip()
    except Exception:
        return ""


def run_dir(run: int) -> Path:
    return ROOT / "runs" / f"r{run:03d}"


# ---------------------------------------------------------------------------
# Minimal YAML frontmatter parsing (scalars, one level of nesting, simple lists).
# Enough for PROTOCOL.md's fixed schema; no external dependency.
# ---------------------------------------------------------------------------

def _coerce(raw: str) -> Any:
    v = raw.strip()
    if not v:
        return ""
    if (v[0] == '"' and v[-1] == '"') or (v[0] == "'" and v[-1] == "'"):
        return v[1:-1]
    low = v.lower()
    if low in ("true", "false"):
        return low == "true"
    if low in ("null", "~", "none"):
        return None
    try:
        return int(v)
    except ValueError:
        pass
    try:
        return float(v)
    except ValueError:
        pass
    return v


def parse_frontmatter(text: str) -> tuple[dict, str]:
    """Return (frontmatter dict, body). Raises ValueError on malformed input."""
    if not text.startswith("---"):
        raise ValueError("file does not start with a '---' frontmatter block")
    end = text.find("\n---", 3)
    if end == -1:
        raise ValueError("unterminated frontmatter block (missing closing '---')")
    head = text[text.find("\n") + 1:end]
    body = text[end + 4:]

    data: dict[str, Any] = {}
    parent: str | None = None
    for lineno, line in enumerate(head.splitlines(), start=2):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        stripped = line.strip()
        if stripped.startswith("- "):
            if parent is None:
                raise ValueError(f"line {lineno}: list item outside a key")
            data.setdefault(parent, [])
            if not isinstance(data[parent], list):
                data[parent] = []
            data[parent].append(_coerce(stripped[2:]))
            continue
        if ":" not in stripped:
            raise ValueError(f"line {lineno}: expected 'key: value'")
        key, _, val = stripped.partition(":")
        key = key.strip()
        if indent == 0:
            if val.strip() == "":
                data[key] = {}
                parent = key
            else:
                data[key] = _coerce(val)
                parent = None
        else:
            if parent is None:
                raise ValueError(f"line {lineno}: indented key without a parent")
            if not isinstance(data.get(parent), dict):
                data[parent] = {}
            data[parent][key] = _coerce(val)
    return data, body


def load_protocol() -> tuple[dict, str]:
    if not PROTOCOL_PATH.exists():
        die("PROTOCOL.md not found — this repo has no project yet")
    try:
        return parse_frontmatter(PROTOCOL_PATH.read_text())
    except ValueError as e:
        die(f"PROTOCOL.md frontmatter: {e}")


# ---------------------------------------------------------------------------
# Redaction
# ---------------------------------------------------------------------------

def _env_secrets() -> list[str]:
    """Literal values of env vars named in .lab-redact (one name per line)."""
    out: list[str] = []
    f = ROOT / ".lab-redact"
    if f.exists():
        for line in f.read_text().splitlines():
            name = line.split("#", 1)[0].strip()
            if not name:
                continue
            val = os.environ.get(name)
            if val and len(val) >= 6:
                out.append(val)
    return out


def redact(value: Any, secrets: list[str] | None = None) -> Any:
    """Recursively strip secret-shaped substrings from strings."""
    secrets = _env_secrets() if secrets is None else secrets
    if isinstance(value, str):
        s = value
        for lit in secrets:
            s = s.replace(lit, REDACTED)
        for pat in REDACT_PATTERNS:
            s = pat.sub(REDACTED, s)
        return s
    if isinstance(value, dict):
        return {k: redact(v, secrets) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v, secrets) for v in value]
    return value


# ---------------------------------------------------------------------------
# Events
# ---------------------------------------------------------------------------

def append_event(event: dict) -> None:
    line = json.dumps(event, separators=(",", ":"), default=str)
    if len(line.encode()) > EVENT_MAX_BYTES:
        die(f"event is {len(line.encode())} bytes, limit is {EVENT_MAX_BYTES} "
            "— put the detail in a summary.md, not the public feed")
    EVENTS_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(EVENTS_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, (line + "\n").encode())   # single atomic append
    finally:
        os.close(fd)


def ingest_push(event: dict) -> None:
    """Best-effort realtime push to nullsilver.com. Silent on any failure:
    git is the source of truth and the site backfills on push."""
    url = os.environ.get("NULLSILVER_INGEST_URL")
    if not url:
        return
    try:
        import urllib.request
        req = urllib.request.Request(
            url,
            data=json.dumps(event, default=str).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        token = os.environ.get("NULLSILVER_TOKEN")
        if token:
            req.add_header("Authorization", f"Bearer {token}")
        urllib.request.urlopen(req, timeout=2).read(1)
    except Exception:
        pass


def _metric_throttled(trial: str) -> bool:
    """True if a metric event for this trial was emitted < 60s ago."""
    LAB_DIR.mkdir(parents=True, exist_ok=True)
    path = LAB_DIR / "metric_throttle.json"
    try:
        seen = json.loads(path.read_text())
    except Exception:
        seen = {}
    last = seen.get(trial, 0)
    now = time.time()
    if now - last < METRIC_MIN_INTERVAL_SEC:
        return True
    seen[trial] = now
    write_json_atomic(path, seen)
    return False


def emit(etype: str, msg: str, data: dict | None = None,
         state: dict | None = None, trial: str | None = None) -> dict | None:
    """Validate, redact and append one event. Returns the event, or None if dropped."""
    if etype not in EVENT_FEED:
        die(f"unknown event type '{etype}'. Known types: {', '.join(sorted(EVENT_FEED))}")

    if etype == "metric":
        key = trial or (data or {}).get("trial") or "global"
        if _metric_throttled(str(key)):
            # Not an error: full-resolution metrics live in results.jsonl.
            warn(f"metric event throttled (<{METRIC_MIN_INTERVAL_SEC}s since last for {key})")
            return None

    msg = " ".join(str(msg).split())          # single line, collapse whitespace
    if len(msg) > MSG_MAX:
        warn(f"msg truncated to {MSG_MAX} chars (it renders in the site news column)")
        msg = msg[: MSG_MAX - 1].rstrip() + "…"

    st = state if state is not None else (load_state() if STATE_PATH.exists() else {})
    data = dict(data or {})
    if trial:
        data.setdefault("trial", trial)

    event = {
        "ts": now_iso(),
        "type": etype,
        "phase": st.get("phase"),
        "run": st.get("run"),
        "revision": st.get("revision"),
        "msg": msg,
        "data": data,
    }
    event = redact(event)
    append_event(event)
    ingest_push(event)
    return event


# ---------------------------------------------------------------------------
# LEDGER
# ---------------------------------------------------------------------------

LEDGER_HEADER = """# LEDGER — every trial, ever

One row per trial. Never delete a row; a failed or killed trial is evidence.
Statuses: `running | done | killed | invalidated`.
Verdicts (against the **pre-registered** gate in the spec): `GO | NO-GO | INCONCLUSIVE`.
Rows are written by `lab trial new` / `lab trial done` — edit the note column by hand
if you must, never the rest.

| run | exp | trial | status | verdict | path | note |
|---|---|---|---|---|---|---|
"""


def ledger_upsert(trial_id: str, row: dict) -> None:
    """Insert or replace the row for trial_id, preserving file order."""
    if not LEDGER_PATH.exists():
        LEDGER_PATH.write_text(LEDGER_HEADER)
    lines = LEDGER_PATH.read_text().splitlines()
    new = "| {run} | {exp} | {trial} | {status} | {verdict} | `{path}` | {note} |".format(
        run=row.get("run", ""), exp=row.get("exp", ""), trial=trial_id,
        status=row.get("status", ""), verdict=row.get("verdict") or "",
        path=row.get("path", ""), note=(row.get("note") or "").replace("|", "/"),
    )
    for i, line in enumerate(lines):
        if line.startswith("|") and f"| {trial_id} |" in line:
            lines[i] = new
            break
    else:
        lines.append(new)
    LEDGER_PATH.write_text("\n".join(lines) + "\n")


# ---------------------------------------------------------------------------
# Environment fingerprinting (absorbed from labloop's explogger.py)
# ---------------------------------------------------------------------------

DEFAULT_PACKAGES = [
    "torch", "transformers", "numpy", "scipy", "pandas", "datasets",
    "jax", "sklearn", "scikit-learn", "accelerate", "vllm",
]


def package_versions(extra: list[str]) -> dict[str, str]:
    from importlib import metadata
    versions = {"python": platform.python_version(), "executable": sys.executable}
    for name in [*DEFAULT_PACKAGES, *extra]:
        try:
            versions[name] = metadata.version(name)
        except Exception:
            continue
    return versions


def hardware_fingerprint() -> dict:
    hw: dict[str, Any] = {
        "platform": platform.platform(),
        "machine": platform.machine(),
        "processor": platform.processor(),
        "hostname": platform.node(),
        "cpu_count": os.cpu_count(),
    }
    try:
        if sys.platform == "darwin":
            hw["cpu_model"] = subprocess.run(
                ["sysctl", "-n", "machdep.cpu.brand_string"],
                capture_output=True, text=True, timeout=5).stdout.strip()
            mem = subprocess.run(["sysctl", "-n", "hw.memsize"],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
            if mem.isdigit():
                hw["ram_gb"] = round(int(mem) / 2**30, 1)
        else:
            pages = os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")
            hw["ram_gb"] = round(pages / 2**30, 1)
    except Exception:
        pass
    try:
        smi = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"],
            capture_output=True, text=True, timeout=10)
        if smi.returncode == 0 and smi.stdout.strip():
            hw["gpus"] = [g.strip() for g in smi.stdout.strip().splitlines()]
    except Exception:
        pass
    return hw


