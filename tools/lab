def cmd_format(args) -> None:
    if args.action == "show":
        print(json.dumps(format_manifest(), indent=2))
        return
    if args.action == "version":
        print(FORMAT_VERSION)
        return
    write_json_atomic(FORMAT_PATH, format_manifest())
    print(f"FORMAT.json synced to format {FORMAT_VERSION}")


