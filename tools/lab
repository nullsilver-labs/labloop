# validate
# ---------------------------------------------------------------------------

def cmd_validate(args) -> None:
    errors: list[str] = []
    notes: list[str] = []

    def err(msg: str) -> None:
        errors.append(msg)

    # --- FORMAT.json -------------------------------------------------------
    if not FORMAT_PATH.exists():
        err("FORMAT.json is missing — run `lab format sync`")
    else:
        try:
            published = json.loads(FORMAT_PATH.read_text())
            if published != format_manifest():
                if published.get("format") != FORMAT_VERSION:
                    err(f"FORMAT.json declares format {published.get('format')} but this "
                        f"lab writes {FORMAT_VERSION}. Consumers parse the declared "
                        "version, so it must be true: run `lab format sync`.")
                else:
                    err("FORMAT.json has drifted from the contract in tools/lab — "
                        "run `lab format sync` (it is generated, never hand-edited)")
        except json.JSONDecodeError as e:
            err(f"FORMAT.json is not valid JSON: {e}")

    # --- events.jsonl ------------------------------------------------------
    if EVENTS_PATH.exists():
        for i, line in enumerate(EVENTS_PATH.read_text().splitlines(), start=1):
            if not line.strip():
                continue
            if len(line.encode()) > EVENT_MAX_BYTES:
                err(f"events.jsonl:{i} exceeds {EVENT_MAX_BYTES} bytes")
            try:
                ev = json.loads(line)
            except json.JSONDecodeError as e:
                err(f"events.jsonl:{i} is not valid JSON: {e}")
                continue
            major = str(ev.get("format", "")).split(".")[0]
            if major == FORMAT_VERSION.split(".")[0] and ev.get("type") not in EVENT_FEED:
                err(f"events.jsonl:{i} unknown event type '{ev.get('type')}'")
            for k in ("ts", "type", "msg"):
                if k not in ev:
                    err(f"events.jsonl:{i} missing key '{k}'")
            msg = ev.get("msg", "")
            if len(msg) > MSG_MAX:
                err(f"events.jsonl:{i} msg is {len(msg)} chars (max {MSG_MAX})")
            if "\n" in msg:
                err(f"events.jsonl:{i} msg contains a newline")
    else:
        notes.append("no events.jsonl yet (written by the first `lab run`)")

    # every known type must have a feed class
    for t in EVENT_FEED:
        if EVENT_FEED[t] not in ("news", "activity", "none"):
            err(f"event type '{t}' has no valid feed class")

    # --- population.json and the candidate dirs ----------------------------
    popp = ROOT / "population.json"
    if popp.exists():
        C = _campaign_module()
        F = _findings_module()
        try:
            pop = json.loads(popp.read_text())
        except json.JSONDecodeError as e:
            err(f"population.json is not valid JSON: {e}")
            pop = {}
        if pop:
            for k in ("format", "campaign", "status", "candidates", "claim"):
                if k not in pop:
                    err(f"population.json missing key '{k}'")
            if pop.get("status") not in C.CAMPAIGN_STATUS:
                err(f"population.json status='{pop.get('status')}' is not a campaign status")
            if pop.get("claim") not in C.CLAIMS:
                err(f"population.json claim='{pop.get('claim')}' is not a claim")
            for cid, c in (pop.get("candidates") or {}).items():
                cdir = ROOT / c.get("path", f"candidates/{cid}")
                if c.get("status") not in C.CAND_STATUS:
                    err(f"population.json {cid} status='{c.get('status')}' is not a candidate status")
                if c.get("operator") not in C.OPERATORS:
                    err(f"population.json {cid} operator='{c.get('operator')}' is not an operator")
                if not (cdir / "config.json").exists():
                    err(f"{cdir.relative_to(ROOT)} has no config.json")
                if c.get("status") in ("evaluated", "failed", "deferred", "frozen"):
                    if not (cdir / "summary.md").exists():
                        err(f"{cdir.relative_to(ROOT)} settled without a summary.md")
                if c.get("status") in ("evaluated", "frozen") and not (cdir / "fitness.json").exists():
                    err(f"{cdir.relative_to(ROOT)} is evaluated but has no fitness.json")
            mem = pop.get("memory") or {"policy": "legacy"}
            if mem.get("policy") not in C.MEMORY_POLICIES:
                err(f"population.json memory policy '{mem.get('policy')}' is unknown")
            elif F.is_findings(mem["policy"]):
                # cards are required only for settled attempts of an opted-in campaign
                for cid, c in (pop.get("candidates") or {}).items():
                    if c.get("exec") not in F.EXEC_STATUSES:
                        continue
                    fp = ROOT / c.get("path", f"candidates/{cid}") / "finding.json"
                    if not fp.exists():
                        err(f"{fp.relative_to(ROOT)} is missing for a settled candidate (memory {mem['policy']})")
                        continue
                    try:
                        card = json.loads(fp.read_text())
                        problems = F.validate_card(card, mem["policy"])
                    except (OSError, json.JSONDecodeError, UnicodeDecodeError) as e:
                        card, problems = None, [f"unreadable: {e}"]
                    for pr in problems:
                        err(f"{fp.relative_to(ROOT)}: {pr}")
                    if not problems and (card.get("candidate") != cid or
                                         (card.get("execution") or {}).get("exec") != c.get("exec")):
                        err(f"{fp.relative_to(ROOT)} does not match population.json")
                    if not problems and card.get("schema") != F.SCHEMAS[mem["policy"]]:
                        err(f"{fp.relative_to(ROOT)} is a {card.get('schema')} card under "
                            f"memory {mem['policy']}")
    else:
        notes.append("no population.json (no campaign has run here)")

    for n in notes:
        print(f"note: {n}")
    if errors:
        for e in errors:
            print(f"FAIL: {e}", file=sys.stderr)
        print(f"\nlab validate: {len(errors)} problem(s)", file=sys.stderr)
        sys.exit(1)
    print("lab validate: OK" + (f" ({len(notes)} note(s))" if notes else ""))


