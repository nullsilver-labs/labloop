def main(argv: list[str] | None = None) -> None:
    p = argparse.ArgumentParser(prog="lab", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("log", help="append an event to the public feed")
    sp.add_argument("type", help=f"one of: {', '.join(sorted(EVENT_FEED))}")
    sp.add_argument("--msg", required=True, help=f"<= {MSG_MAX} chars, one line")
    sp.add_argument("--data", help="JSON object with the structured payload")
    sp.add_argument("--candidate", help="candidate id (metric throttling is per candidate)")
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("events", help="read the event feed")
    sp.add_argument("action", choices=["tail"])
    sp.add_argument("-n", type=int, default=20)
    sp.add_argument("--class", dest="feed_class", choices=["news", "activity", "none"])
    sp.set_defaults(func=cmd_events)

    sp = sub.add_parser("watch", help="detached watchdog for long-running work")
    wsub = sp.add_subparsers(dest="watch_cmd", required=True)
    w = wsub.add_parser("start", help="launch a command under a detached watcher")
    w.add_argument("--op", required=True, help="name for the work (a job, a download, the campaign)")
    w.add_argument("--budget-min", type=int, required=True, help="wall-clock kill budget")
    w.add_argument("--stall-min", type=int, default=0,
                   help="kill if no new log output AND no CPU activity in the child's "
                        "process tree for this many minutes")
    w.add_argument("--kill-regex", help="kill when this pattern appears in new log output")
    w.add_argument("--candidate-dir", help=argparse.SUPPRESS)  # lab run's owned job tree
    w.add_argument("command", nargs=argparse.REMAINDER,
                   help="-- <command...> to run and supervise")
    w.set_defaults(func=cmd_watch_start)
    w = wsub.add_parser("_run")           # internal: the detached watcher process
    w.add_argument("id")
    w.set_defaults(func=cmd_watch_run)
    w = wsub.add_parser("list")
    w.add_argument("--json", action="store_true")
    w.set_defaults(func=cmd_watch_list)
    w = wsub.add_parser("check", help="repair dead watchers; report live/pending")
    w.add_argument("--counts", action="store_true", help="print 'live=N pending=M'")
    w.add_argument("--fingerprint", action="store_true",
                   help="stable hash of watch ids+statuses (drivers detect change)")
    w.add_argument("--next-deadline", action="store_true",
                   help="seconds until the nearest live watch budget deadline")
    w.set_defaults(func=cmd_watch_check)
    w = wsub.add_parser("kill", help="ask the watcher to kill its child")
    w.add_argument("id")
    w.add_argument("--reason", required=True)
    w.set_defaults(func=cmd_watch_kill)
    w = wsub.add_parser("close", help="archive a finished watch")
    w.add_argument("id")
    w.set_defaults(func=cmd_watch_close)

    sp = sub.add_parser("usage", help="token usage per session/model/role — reads "
                                      "session transcripts")
    sp.add_argument("--since", help="YYYY-MM-DD (UTC); default: all recorded sessions")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_usage)

    sp = sub.add_parser("validate", help="lint the repo against the contract")
    sp.set_defaults(func=cmd_validate)

    sp = sub.add_parser("format", help="the output-format contract for consumers")
    sp.add_argument("action", choices=["show", "sync", "version"],
                    help="show = print the manifest; sync = write FORMAT.json; "
                         "version = print the format version alone")
    sp.set_defaults(func=cmd_format)

    # The search loop (docs/aira2-loop-design.md). Registered from its own module; a failure to
    # import it must not take the plumbing down with it.
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        import lab_campaign
        lab_campaign.register(sub, sys.modules[__name__])
    except Exception as e:  # pragma: no cover
        warn(f"campaign commands unavailable: {e}")

    args = p.parse_args(argv)

    # events.jsonl and LEDGER.md are read-modify-write; `lab run` and a hand-run
    # `lab log` or `lab eval` can be concurrent. One blocking flock serializes them.
    # The watcher's long-lived `_run` loop never takes it (it mutates only its own
    # registry file); `lab run` holds its own campaign.lock for the loop and takes
    # this one per write through ledger_lock().
    if args.cmd in ("log", "eval"):
        LAB_DIR.mkdir(parents=True, exist_ok=True)
        lock = open(LAB_DIR / "lab.lock", "w")
        t0 = time.time()
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.time() - t0 > 120:
                    die("could not take .lab/lab.lock within 120s — another lab "
                        "process is stuck holding it")
                time.sleep(0.2)
    args.func(args)


if __name__ == "__main__":
    main()
