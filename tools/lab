# ---------------------------------------------------------------------------
# The contract: phases, transitions, statuses, event types and their feed class.
# ---------------------------------------------------------------------------

# Output format version, as consumed by nullsilver.com and any other parser.
# MAJOR bumps when a consumer that ignores the change would misread the data:
# a key renamed or removed, a phase or status renamed, an event type's feed class
# changed, a limit tightened. MINOR bumps for additive changes a consumer can
# safely ignore: a new event type, a new optional key, a new phase appended.
#
# It is stamped into state.json, into every event as it is written, and into each
# trial's config.json, and published whole in FORMAT.json. Per-event stamping is
# what makes an append-only feed readable across upgrades: lines written by an
# older lab keep their old version forever, so a consumer never has to guess which
# rules applied to a given line. A missing `format` means pre-1.0.
#
# Version history lives in README.md under "Format versioning".
FORMAT_VERSION = "1.2"

PHASES = ["init", "build", "pilot", "execute", "analyze", "decide", "conclude"]

# phase -> the phases it may legally exit to (see CLAUDE.md / the state machine)
