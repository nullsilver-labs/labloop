def cmd_log(args) -> None:
    data = {}
    if args.data:
        try:
            data = json.loads(args.data)
        except json.JSONDecodeError as e:
            die(f"--data is not valid JSON: {e}")
        if not isinstance(data, dict):
            die("--data must be a JSON object")
    ev = emit(args.type, args.msg, data, candidate=args.candidate)
    if ev is None:
        sys.exit(0)
    print(json.dumps(ev, separators=(",", ":")))


def cmd_events(args) -> None:
    if not EVENTS_PATH.exists():
        return
    lines = [l for l in EVENTS_PATH.read_text().splitlines() if l.strip()]
    if args.feed_class:
        keep = []
        for l in lines:
            try:
                if EVENT_FEED.get(json.loads(l).get("type")) == args.feed_class:
                    keep.append(l)
            except json.JSONDecodeError:
                continue
        lines = keep
    for l in lines[-args.n:]:
        print(l)


# ---------------------------------------------------------------------------
# watch — a detached, mechanical supervisor for long-running work.
#
# The contract that makes detachment legal (CLAUDE.md "Long runs"): a session may
# end its turn while work runs ONLY if that work is under a watcher, because the
# watcher — not the session — enforces the budget. One watcher per process, setsid
# so it survives the session that launched it; it heartbeats and kills on
# wall-clock / stall / kill-regex / session request. `lab run` launches every job
# this way and reads the entry back when it reaps, so a killed job is settled
# mechanically, never left to a session coming back.
#
# Registry: .lab/watch/<id>.json, written only by its watcher while status=running,
# then never again — so `close` can archive it to .lab/watch/done/ without racing.
# A session asks for a kill by writing .lab/watch/<id>.kill (the reason, one line);
# the watcher picks it up within one poll.
# ---------------------------------------------------------------------------

WATCH_DIR = LAB_DIR / "watch"
WATCH_ARCHIVE = WATCH_DIR / "done"
WATCH_POLL_SEC = float(os.environ.get("LAB_WATCH_POLL_SEC") or 15)  # tests shorten it
WATCH_TERM_GRACE_SEC = 30
WATCH_HEARTBEAT_STALE_SEC = 120   # 8 missed polls => the watcher itself is presumed dead


def _watch_path(wid: str) -> Path:
    return WATCH_DIR / f"{wid}.json"


def _pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def _watch_entries() -> list[dict]:
    if not WATCH_DIR.exists():
        return []
    out = []
    for p in sorted(WATCH_DIR.glob("*.json")):
        try:
            out.append(json.loads(p.read_text()))
        except (json.JSONDecodeError, OSError):
            warn(f"unreadable watch entry {p}")
    return out


def _watch_repair(entry: dict) -> dict:
    """If a watcher died without finalizing its entry, say so on disk (idempotent)."""
    if entry.get("status") != "running" or _pid_alive(entry.get("pid")):
        return entry
    hb = entry.get("heartbeat") or entry.get("started")
    stale = True
    try:
        age = time.time() - datetime.fromisoformat(hb.replace("Z", "+00:00")).timestamp()
        stale = age > WATCH_HEARTBEAT_STALE_SEC
    except (ValueError, AttributeError):
        pass
    if not stale:
        return entry
    entry["status"] = "failed"
    entry["kill_reason"] = "watcher process died without finalizing (repaired by `lab watch check`)"
    entry["ended"] = now_iso()
    if _pid_alive(entry.get("child_pid")):
        warn(f"watch {entry['id']}: watcher dead but child {entry['child_pid']} still "
             f"alive — an unenforced orphan. Kill it or re-watch it.")
    write_json_atomic(_watch_path(entry["id"]), entry)
    return entry


def cmd_watch_start(args) -> None:
    if os.environ.get("LAB_ROLE") == "worker":
        die("workers cannot start nested watchers; run synchronously under the candidate watcher")
    cmd = list(args.command or [])
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        die("no command given. Usage: lab watch start --op NAME --budget-min N "
            "[--stall-min N] [--kill-regex RE] -- <command...>")
    if not args.op:
        die("--op NAME is required (a job, a download, the campaign itself)")
    if args.budget_min is None:
        die("a watch without a wall-clock budget is an unenforced orphan: pass --budget-min")

    slug = re.sub(r"[^a-z0-9-]+", "-", args.op.lower()).strip("-") or "op"
    wid = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M") + "-" + slug
    log_path = WATCH_DIR / f"{wid}.log"
    if _watch_path(wid).exists():
        die(f"watch {wid} already exists")

    WATCH_DIR.mkdir(parents=True, exist_ok=True)
    WATCH_ARCHIVE.mkdir(parents=True, exist_ok=True)
    entry = {
        "format": FORMAT_VERSION,
        "id": wid,
        "kind": "op",
        "candidate_dir": args.candidate_dir,
        "name": args.op,
        "cmd": cmd,
        "log": str(log_path.relative_to(ROOT)),
        "budget_min": args.budget_min,
        "stall_min": args.stall_min or 0,
        "kill_regex": args.kill_regex or "",
        "started": now_iso(),
        "heartbeat": now_iso(),
        "pid": None,
        "child_pid": None,
        "status": "running",
        "exit_code": None,
        "kill_reason": None,
        "ended": None,
    }
    write_json_atomic(_watch_path(wid), entry)
    # Detach: re-exec ourselves as the watcher in a fresh session (setsid), so the
    # watcher and its child survive the session that launched them.
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "watch", "_run", wid],
        start_new_session=True, cwd=str(ROOT),
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    print(wid)


def _session_cpu_seconds(sid_pid: int) -> float:
    """Total CPU seconds consumed by the child's session (it is launched with
    start_new_session=True, so `ps -g <pid>` selects its whole process tree).
    Returns 0.0 where that can't be measured; callers treat 0 growth as silence."""
    try:
        out = subprocess.run(["ps", "-o", "time=", "-g", str(sid_pid)],
                             capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return 0.0
    total = 0.0
    for tok in out.split():
        days, rest = (tok.split("-", 1) if "-" in tok else ("0", tok))
        try:
            parts = [int(p) for p in rest.split(":")]
        except ValueError:
            continue
        while len(parts) < 3:
            parts.insert(0, 0)
        total += int(days) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]
    return total


def cmd_watch_run(args) -> None:
    """The watcher process itself (internal; launched detached by `watch start`)."""
    if os.environ.get("LAB_ROLE") == "worker":
        die("workers cannot run nested watchers")
    path = _watch_path(args.id)
    entry = json.loads(path.read_text())
    log_path = ROOT / entry["log"]
    log_path.parent.mkdir(parents=True, exist_ok=True)
    logf = open(log_path, "ab", buffering=0)
    contained = bool(entry.get("candidate_dir"))
    child_env = os.environ.copy()
    if contained:
        import lab_process
        lab_process.enable_subreaper()
        child_env.update(LAB_ROLE="worker", LAB_CANDIDATE_DIR=entry["candidate_dir"])
    child = subprocess.Popen(entry["cmd"], cwd=str(ROOT), stdin=subprocess.DEVNULL,
                             stdout=logf, stderr=subprocess.STDOUT,
                             start_new_session=True, env=child_env)
    entry["pid"] = os.getpid()
    entry["child_pid"] = child.pid
    write_json_atomic(path, entry)

    started = time.time()
    deadline = started + entry["budget_min"] * 60
    stall_sec = (entry.get("stall_min") or 0) * 60
    pattern = re.compile(entry["kill_regex"]) if entry.get("kill_regex") else None
    kill_file = WATCH_DIR / f"{entry['id']}.kill"
    log_offset = 0
    log_carry = b""          # the unterminated tail of the last chunk read
    kill_reason = None

    def freshest_output_age() -> float:
        try:
            return time.time() - log_path.stat().st_mtime
        except OSError:
            return 0.0

    # File mtimes are a *progress* signal, not a *liveness* signal: a stage that
    # makes dozens of sequential model calls between checkpoints writes nothing
    # while being perfectly healthy. CPU time in the child's process tree is the
    # liveness signal the watcher can read without the job's cooperation, so a
    # stall kill requires BOTH: no new output AND no CPU activity for stall_min.
    cpu_seen = 0.0
    cpu_last_tick = time.time()

    while True:
        rc = child.poll()
        if rc is not None:
            break
        if stall_sec:
            cpu_now = _session_cpu_seconds(child.pid)
            if cpu_now > cpu_seen:
                cpu_seen = cpu_now
                cpu_last_tick = time.time()
            entry["cpu_seconds"] = cpu_seen
        if kill_file.exists():
            kill_reason = kill_file.read_text().strip() or "killed by session request"
        elif time.time() > deadline:
            kill_reason = f"wall-clock budget {entry['budget_min']} min exceeded"
        elif (stall_sec and freshest_output_age() > stall_sec
              and time.time() - cpu_last_tick > stall_sec):
            kill_reason = (f"stalled: no new output and no CPU activity "
                           f"in {entry['stall_min']} min")
        elif pattern:
            try:
                with open(log_path, "rb") as f:
                    f.seek(log_offset)
                    chunk = f.read()
                log_offset += len(chunk)
                # The unterminated tail is searched now (a message with no line end must
                # still kill) and carried, so a line split across two polls is seen whole.
                # The carry always begins at a true line start: a line that never ends is
                # kept only up to 64 KiB from its start, never re-anchored mid-line.
                chunk = log_carry + chunk
                cut = chunk.rfind(b"\n") + 1
                log_carry = chunk[cut:][:65536]
                m = pattern.search(chunk.decode("utf-8", "replace"))
                if m:
                    kill_reason = f"kill pattern matched: {m.group(0)[:80]!r}"
            except OSError:
                pass
        if kill_reason:
            if contained:
                # Do not kill the subreaper (this watcher): detached children must
                # be adopted and drained before its entry can become terminal.
                rc = -signal.SIGTERM
                break
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except (OSError, ProcessLookupError):
                pass
            t0 = time.time()
            while child.poll() is None and time.time() - t0 < WATCH_TERM_GRACE_SEC:
                time.sleep(1)
            if child.poll() is None:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except (OSError, ProcessLookupError):
                    pass
            rc = child.wait()
            break
        entry["heartbeat"] = now_iso()
        write_json_atomic(path, entry)
        time.sleep(WATCH_POLL_SEC)

    if contained:
        while True:
            try:
                pending = lab_process.cleanup(child)
                if pending and not kill_reason:
                    rc = 2
                    logf.write(b"lab watch: lifecycle violation: live candidate descendants cleaned up\n")
                break
            except RuntimeError as exc:
                # Unkillable kernel I/O cannot safely release a lease. Keep the
                # watcher alive and visible rather than settling over late work.
                logf.write((str(exc) + "\n").encode())
                if not kill_reason:
                    rc = 2
                entry["cleanup_error"] = str(exc)
                entry["heartbeat"] = now_iso()
                write_json_atomic(path, entry)
                time.sleep(WATCH_POLL_SEC)
    logf.close()
    entry["exit_code"] = rc
    entry["ended"] = now_iso()
    entry["heartbeat"] = now_iso()
    if kill_reason:
        entry["status"] = "killed"
        entry["kill_reason"] = kill_reason
    else:
        entry["status"] = "done" if rc == 0 else "failed"
    write_json_atomic(path, entry)


def cmd_watch_list(args) -> None:
    entries = [_watch_repair(e) for e in _watch_entries()]
    if args.json:
        print(json.dumps(entries, indent=2))
        return
    if not entries:
        print("no watches (archive: .lab/watch/done/)")
        return
    for e in entries:
        extra = f" kill_reason={e['kill_reason']!r}" if e.get("kill_reason") else ""
        print(f"{e['id']}  {e['kind']}:{e['name']}  {e['status']}"
              f"  budget={e['budget_min']}min  log={e['log']}{extra}")


def cmd_watch_check(args) -> None:
    entries = [_watch_repair(e) for e in _watch_entries()]
    live = [e for e in entries if e["status"] == "running"]
    pending = [e for e in entries if e["status"] != "running"]
    if args.counts:
        print(f"live={len(live)} pending={len(pending)}")
        return
    if args.fingerprint:
        sig = ";".join(f"{e['id']}:{e['status']}" for e in entries)
        print(hashlib.sha256(sig.encode()).hexdigest()[:12])
        return
    if args.next_deadline:
        secs = []
        for e in live:
            try:
                t0 = datetime.fromisoformat(e["started"].replace("Z", "+00:00")).timestamp()
                secs.append(int(t0 + e["budget_min"] * 60 - time.time()))
            except (ValueError, KeyError):
                pass
        print(min(secs) if secs else "")
        return
    for e in entries:
        print(f"{e['id']}  {e['status']}  heartbeat={e.get('heartbeat')}")
    if not entries:
        print("no watches")


def cmd_watch_kill(args) -> None:
    entry = next((e for e in _watch_entries() if e["id"] == args.id), None)
    if entry is None:
        die(f"no watch {args.id}")
    if entry["status"] != "running":
        die(f"watch {args.id} is {entry['status']}, not running")
    if not args.reason:
        die("--reason is required: the kill reason lands in the candidate's summary and LEDGER")
    (WATCH_DIR / f"{args.id}.kill").write_text(args.reason.strip() + "\n")
    print(f"kill requested; the watcher will act within {WATCH_POLL_SEC}s")


def cmd_watch_close(args) -> None:
    path = _watch_path(args.id)
    if not path.exists():
        die(f"no watch {args.id}")
    entry = _watch_repair(json.loads(path.read_text()))
    if entry["status"] == "running":
        die(f"watch {args.id} is still running — kill it or wait for it")
    WATCH_ARCHIVE.mkdir(parents=True, exist_ok=True)
    path.rename(WATCH_ARCHIVE / path.name)
    kf = WATCH_DIR / f"{args.id}.kill"
    if kf.exists():
        kf.rename(WATCH_ARCHIVE / kf.name)
    print(f"archived to .lab/watch/done/{path.name}")


# ---------------------------------------------------------------------------
# usage — where the tokens went.
#
# Reads the session records in .lab/sessions/*.json (written by the SessionStart
# hook for every session: worker and operator alike) and pulls per-turn usage from
# each session's Claude Code transcript. Subagent (sidechain) turns are counted and
# attributed separately, so delegation shows up as delegation instead of vanishing
# into the parent's numbers. The per-candidate list-price view is `lab campaign
# usage`, read from each worker's session.json.
#
# `in_equiv` is input-equivalent tokens per model, using the price ratios shared
# by all current Claude models (in 1.0, cache write 1.25, cache read 0.1, out 5.0).
# It compares sessions on the same model; across models, weight by the per-MTok
# price of each before comparing.
# ---------------------------------------------------------------------------

USAGE_KEYS = ("input_tokens", "output_tokens",
              "cache_creation_input_tokens", "cache_read_input_tokens")
IN_EQUIV_WEIGHTS = {"input_tokens": 1.0, "output_tokens": 5.0,
                    "cache_creation_input_tokens": 1.25,
                    "cache_read_input_tokens": 0.1}


def _in_equiv(agg: dict) -> int:
    return int(sum(agg.get(k, 0) * w for k, w in IN_EQUIV_WEIGHTS.items()))


def _usage_add(dst: dict, usage: dict) -> None:
    for k in USAGE_KEYS:
        dst[k] = dst.get(k, 0) + (usage.get(k) or 0)


def _usage_from_lines(lines, sidechain_of) -> dict:
    """Aggregate assistant-message usage from an iterable of JSONL lines.
    sidechain_of(event) says whether the event belongs to a subagent."""
    out = {"turns": 0, "models": {}, "total": {}, "sub": {}, "sub_turns": 0}
    for line in lines:
        try:
            e = json.loads(line)
        except (json.JSONDecodeError, UnicodeDecodeError):
            continue
        if e.get("type") != "assistant":
            continue
        msg = e.get("message") or {}
        usage = msg.get("usage") or {}
        if not usage:
            continue
        out["turns"] += 1
        model = msg.get("model") or "?"
        _usage_add(out["models"].setdefault(model, {}), usage)
        _usage_add(out["total"], usage)
        if sidechain_of(e):
            out["sub_turns"] += 1
            _usage_add(out["sub"], usage)
    return out


def cmd_usage(args) -> None:
    since = None
    if args.since:
        try:
            since = datetime.strptime(args.since, "%Y-%m-%d").timestamp()
        except ValueError:
            die("--since wants YYYY-MM-DD")

    sessions = []
    for rec_path in sorted((LAB_DIR / "sessions").glob("*.json")):
        try:
            rec = json.loads(rec_path.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        start = rec.get("start_epoch") or 0
        if since and start < since:
            continue
        sid = rec.get("session_id", rec_path.stem)
        transcript = rec.get("transcript_path") or ""
        source = transcript if transcript and os.path.exists(transcript) else None
        cand = os.path.basename(rec.get("candidate_dir") or "") or "-"
        row = {"session": sid, "start": start,
               "date": datetime.fromtimestamp(start, tz=timezone.utc)
                       .strftime("%m-%d %H:%M") if start else "?",
               "role": rec.get("role", "operator"), "candidate": cand,
               "source": str(source) if source else None}
        if source:
            u = _usage_from_lines(open(source, encoding="utf-8", errors="replace"),
                                  lambda e: bool(e.get("isSidechain")))
            row.update(u)
            row["in_equiv"] = _in_equiv(u["total"])
        sessions.append(row)
    sessions.sort(key=lambda r: r["start"])

    if args.json:
        print(json.dumps(sessions, indent=2))
        return

    by_model: dict[str, dict] = {}
    by_role: dict[str, dict] = {}
    missing = 0
    for r in sessions:
        if not r.get("source"):
            missing += 1
            continue
        for model, agg in r["models"].items():
            m = by_model.setdefault(model, {"sessions": 0, "turns": 0})
            m["sessions"] += 1
            _usage_add(m, agg)
        m = by_role.setdefault(r["role"], {"sessions": 0, "turns": 0,
                                           "sub_turns": 0, "sub": {}})
        m["sessions"] += 1
        m["turns"] += r["turns"]
        m["sub_turns"] += r["sub_turns"]
        _usage_add(m, r["total"])
        _usage_add(m["sub"], r["sub"])

    print(f"{'date (UTC)':11} {'role':8} {'candidate':9} {'turns':>5} {'sub':>4} "
          f"{'out':>8} {'cache_r':>12} {'in_equiv':>10}")
    for r in sessions:
        if not r.get("source"):
            print(f"{r['date']:11} {r['role'][:8]:8} {r['candidate'][:9]:9} "
                  f"{'—':>5} {'—':>4} {'—':>8} {'—':>12} {'—':>10}  (no transcript)")
            continue
        t = r["total"]
        print(f"{r['date']:11} {r['role'][:8]:8} {r['candidate'][:9]:9} {r['turns']:>5} "
              f"{r['sub_turns']:>4} {t.get('output_tokens',0):>8,} "
              f"{t.get('cache_read_input_tokens',0):>12,} {r['in_equiv']:>10,}")

    print("\nby model (in_equiv compares sessions on the SAME model; across models,"
          " weight by each model's per-MTok price):")
    for model, m in sorted(by_model.items(),
                           key=lambda kv: -_in_equiv(kv[1])):
        print(f"  {model:22} sessions={m['sessions']:<3} in={m.get('input_tokens',0):<10,} "
              f"out={m.get('output_tokens',0):<9,} cache_w={m.get('cache_creation_input_tokens',0):<11,} "
              f"cache_r={m.get('cache_read_input_tokens',0):<13,} in_equiv={_in_equiv(m):,}")
    print("by role:")
    for role, m in sorted(by_role.items(), key=lambda kv: -_in_equiv(kv[1])):
        sub = (f"  (subagents: {m['sub_turns']} turns, in_equiv={_in_equiv(m['sub']):,})"
               if m["sub_turns"] else "")
        print(f"  {role:12} sessions={m['sessions']:<3} turns={m['turns']:<5} "
              f"cache_r={m.get('cache_read_input_tokens',0):<13,} in_equiv={_in_equiv(m):,}{sub}")
    if missing:
        print(f"\n{missing} session(s) had no transcript — their tokens are not counted above.")


