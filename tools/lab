def cmd_init(args) -> None:
    fm, body = load_protocol()
    if PLACEHOLDER in PROTOCOL_PATH.read_text():
        die("PROTOCOL.md still contains REPLACE-ME placeholders — the human writes "
            "revision 1 before the lab starts (see README.md)")
    missing = [k for k in PROTOCOL_REQUIRED_KEYS if k not in fm]
    if missing:
        die(f"PROTOCOL.md frontmatter is missing: {', '.join(missing)}")
    if STATE_PATH.exists() and not args.force:
        die("state.json already exists (use --force only on a fresh clone)")

    state = {
        "format": FORMAT_VERSION,
        "project": fm["id"],
        "kind": fm.get("kind", "research"),
        "phase": "init",
        "run": 1,
        "revision": int(fm.get("revision", 1)),
        "status": "running",
        "models": run_models(1),
        "active_trials": [],
        "awaiting": None,
        "updated_at": now_iso(),
    }
    write_json_atomic(STATE_PATH, state)
    write_json_atomic(FORMAT_PATH, format_manifest())
    EVENTS_PATH.touch()
    (ROOT / "protocol").mkdir(exist_ok=True)
    run_dir(1).joinpath("specs").mkdir(parents=True, exist_ok=True)
    run_dir(1).joinpath("trials").mkdir(parents=True, exist_ok=True)
