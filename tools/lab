# Events
# ---------------------------------------------------------------------------

def append_event(event: dict) -> None:
    line = json.dumps(event, separators=(",", ":"), default=str)
    if len(line.encode()) > EVENT_MAX_BYTES:
        die(f"event is {len(line.encode())} bytes, limit is {EVENT_MAX_BYTES} "
            "— put the detail in a summary.md, not the public feed")
    EVENTS_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(EVENTS_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, (line + "\n").encode())   # single atomic append
    finally:
        os.close(fd)


def ingest_push(event: dict) -> None:
    """Best-effort realtime push to nullsilver.com. Silent on any failure:
    git is the source of truth and the site backfills on push."""
    url = os.environ.get("NULLSILVER_INGEST_URL")
    if not url:
        return
    try:
        import urllib.request
        req = urllib.request.Request(
            url,
            data=json.dumps(event, default=str).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        token = os.environ.get("NULLSILVER_TOKEN")
        if token:
            req.add_header("Authorization", f"Bearer {token}")
        urllib.request.urlopen(req, timeout=2).read(1)
    except Exception:
        pass


def has_event(etype: str) -> bool:
    """True if an event of this type is already in the feed."""
    if not EVENTS_PATH.exists():
        return False
    needle = f'"type":"{etype}"'
    return any(needle in line for line in EVENTS_PATH.read_text().splitlines())


def _metric_throttled(trial: str) -> bool:
    """True if a metric event for this trial was emitted < 60s ago."""
    LAB_DIR.mkdir(parents=True, exist_ok=True)
    path = LAB_DIR / "metric_throttle.json"
    try:
        seen = json.loads(path.read_text())
    except Exception:
        seen = {}
    last = seen.get(trial, 0)
    now = time.time()
    if now - last < METRIC_MIN_INTERVAL_SEC:
        return True
    seen[trial] = now
    write_json_atomic(path, seen)
    return False


def emit(etype: str, msg: str, data: dict | None = None,
         state: dict | None = None, trial: str | None = None) -> dict | None:
    """Validate, redact and append one event. Returns the event, or None if dropped."""
    if etype not in EVENT_FEED:
        die(f"unknown event type '{etype}'. Known types: {', '.join(sorted(EVENT_FEED))}")

    if etype == "metric":
        key = trial or (data or {}).get("trial") or "global"
        if _metric_throttled(str(key)):
            # Not an error: full-resolution metrics live in results.jsonl.
            warn(f"metric event throttled (<{METRIC_MIN_INTERVAL_SEC}s since last for {key})")
            return None

    msg = " ".join(str(msg).split())          # single line, collapse whitespace
    if len(msg) > MSG_MAX:
        warn(f"msg truncated to {MSG_MAX} chars (it renders in the site news column)")
        msg = msg[: MSG_MAX - 1].rstrip() + "…"

    st = state if state is not None else (load_state() if STATE_PATH.exists() else {})
    data = dict(data or {})
    if trial:
        data.setdefault("trial", trial)
    # Provenance is injected here, never asked of a prompt or a hook: the feed is
    # append-only, so a session or run that forgot would stay unattributable forever.
    if etype == "session.start":
        data = {**requested_model(st.get("phase")), **data}
    elif etype == "session.end":
        data = {**agent_record(data.get("phase_ran") or st.get("phase")), **data}
    elif etype == "run.done":
        data.setdefault("models", run_models(st.get("run")))

    event = {
        "format": FORMAT_VERSION,
        "ts": now_iso(),
        "type": etype,
        "phase": st.get("phase"),
        "run": st.get("run"),
        "revision": st.get("revision"),
        "msg": msg,
        "data": data,
    }
    event = redact(event)
    append_event(event)
    ingest_push(event)
    return event


