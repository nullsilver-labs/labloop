DEFAULT_PACKAGES = [
    "torch", "transformers", "numpy", "scipy", "pandas", "datasets",
    "jax", "sklearn", "scikit-learn", "accelerate", "vllm",
]


def package_versions(extra: list[str]) -> dict[str, str]:
    from importlib import metadata
    versions = {"python": platform.python_version(), "executable": sys.executable}
    for name in [*DEFAULT_PACKAGES, *extra]:
        try:
            versions[name] = metadata.version(name)
        except Exception:
            continue
    return versions


def hardware_fingerprint() -> dict:
    hw: dict[str, Any] = {
        "platform": platform.platform(),
        "machine": platform.machine(),
        "processor": platform.processor(),
        "hostname": platform.node(),
        "cpu_count": os.cpu_count(),
    }
    try:
        if sys.platform == "darwin":
            hw["cpu_model"] = subprocess.run(
                ["sysctl", "-n", "machdep.cpu.brand_string"],
                capture_output=True, text=True, timeout=5).stdout.strip()
            mem = subprocess.run(["sysctl", "-n", "hw.memsize"],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
            if mem.isdigit():
                hw["ram_gb"] = round(int(mem) / 2**30, 1)
        else:
            pages = os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")
            hw["ram_gb"] = round(pages / 2**30, 1)
    except Exception:
        pass
    try:
        smi = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"],
            capture_output=True, text=True, timeout=10)
        if smi.returncode == 0 and smi.stdout.strip():
            hw["gpus"] = [g.strip() for g in smi.stdout.strip().splitlines()]
    except Exception:
        pass
    return hw


