# ---------------------------------------------------------------------------
# watch — a detached, mechanical supervisor for long-running work.
#
# The contract that makes detachment legal (CLAUDE.md "Long runs"): a phase session
# may end its turn while work runs ONLY if that work is under a watcher, because the
# watcher — not the session — enforces the budget. One watcher per process, setsid so
# it survives the session; it heartbeats, kills on wall-clock / stall / kill-regex /
# session request, and for trials it writes a facts-only summary stub and closes the
# trial through `lab trial done --killed`, so the LEDGER never depends on a session
# coming back. Judgment (real summaries, curve reading) stays with sessions; the
# driver (loop.sh / orchestrator) launches one when a watch needs paperwork.
#
# Registry: .lab/watch/<id>.json, written only by its watcher while status=running,
# then never again — so `close` can archive it to .lab/watch/done/ without racing.
# A session asks for a kill by writing .lab/watch/<id>.kill (the reason, one line);
# the watcher picks it up within one poll and owns the paperwork.
# ---------------------------------------------------------------------------

WATCH_DIR = LAB_DIR / "watch"
WATCH_ARCHIVE = WATCH_DIR / "done"
WATCH_POLL_SEC = 15
WATCH_TERM_GRACE_SEC = 30
WATCH_HEARTBEAT_STALE_SEC = 120   # 8 missed polls => the watcher itself is presumed dead


def _watch_path(wid: str) -> Path:
    return WATCH_DIR / f"{wid}.json"


def _pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def _watch_entries() -> list[dict]:
    if not WATCH_DIR.exists():
        return []
    out = []
    for p in sorted(WATCH_DIR.glob("*.json")):
        try:
            out.append(json.loads(p.read_text()))
        except (json.JSONDecodeError, OSError):
            warn(f"unreadable watch entry {p}")
    return out


def _watch_repair(entry: dict) -> dict:
    """If a watcher died without finalizing its entry, say so on disk (idempotent)."""
    if entry.get("status") != "running" or _pid_alive(entry.get("pid")):
        return entry
    hb = entry.get("heartbeat") or entry.get("started")
    stale = True
    try:
        age = time.time() - datetime.fromisoformat(hb.replace("Z", "+00:00")).timestamp()
        stale = age > WATCH_HEARTBEAT_STALE_SEC
    except (ValueError, AttributeError):
        pass
    if not stale:
        return entry
    entry["status"] = "failed"
    entry["kill_reason"] = "watcher process died without finalizing (repaired by `lab watch check`)"
    entry["ended"] = now_iso()
    if _pid_alive(entry.get("child_pid")):
        warn(f"watch {entry['id']}: watcher dead but child {entry['child_pid']} still "
             f"alive — an unenforced orphan. Kill it or re-watch it.")
    write_json_atomic(_watch_path(entry["id"]), entry)
    return entry


def cmd_watch_start(args) -> None:
    cmd = list(args.command or [])
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        die("no command given. Usage: lab watch start (--trial DIR | --op NAME) "
            "[--budget-min N] [--stall-min N] [--kill-regex RE] -- <command...>")
    if bool(args.trial) == bool(args.op):
        die("exactly one of --trial DIR or --op NAME is required")

    budget_min = args.budget_min
    if args.trial:
        tdir = Path(args.trial)
        if not tdir.is_absolute():
            tdir = ROOT / tdir
        if not (tdir / "config.json").exists():
            die(f"{args.trial} is not a trial dir")
        wid = tdir.name
        log_path = tdir / "console.log"
        if budget_min is None:
            cfg = json.loads((tdir / "config.json").read_text())
            hours = (cfg.get("config", {}).get("kill", {}) or {}).get("max_wall_clock_hours")
            if hours:
                budget_min = int(float(hours) * 60)
        name = wid
    else:
        slug = re.sub(r"[^a-z0-9-]+", "-", args.op.lower()).strip("-") or "op"
        wid = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M") + "-" + slug
        log_path = WATCH_DIR / f"{wid}.log"
        name = args.op
    if budget_min is None:
        die("a watch without a wall-clock budget is an unenforced orphan: pass "
            "--budget-min (trials may omit it if config kill.max_wall_clock_hours is set)")
    if _watch_path(wid).exists():
        die(f"watch {wid} already exists")

    WATCH_DIR.mkdir(parents=True, exist_ok=True)
    WATCH_ARCHIVE.mkdir(parents=True, exist_ok=True)
    entry = {
        "format": FORMAT_VERSION,
        "id": wid,
        "kind": "trial" if args.trial else "op",
        "name": name,
        "trial_dir": str(tdir.relative_to(ROOT)) if args.trial else None,
        "cmd": cmd,
        "log": str(log_path.relative_to(ROOT)),
        "budget_min": budget_min,
        "stall_min": args.stall_min or 0,
        "kill_regex": args.kill_regex or "",
        "started": now_iso(),
        "heartbeat": now_iso(),
        "pid": None,
        "child_pid": None,
        "status": "running",
        "exit_code": None,
        "kill_reason": None,
        "ended": None,
    }
    write_json_atomic(_watch_path(wid), entry)
    # Detach: re-exec ourselves as the watcher in a fresh session (setsid), so the
    # watcher and its child survive the phase session that launched them.
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "watch", "_run", wid],
        start_new_session=True, cwd=str(ROOT),
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    print(wid)


def cmd_watch_run(args) -> None:
    """The watcher process itself (internal; launched detached by `watch start`)."""
    path = _watch_path(args.id)
    entry = json.loads(path.read_text())
    log_path = ROOT / entry["log"]
    log_path.parent.mkdir(parents=True, exist_ok=True)
    logf = open(log_path, "ab", buffering=0)
    child = subprocess.Popen(entry["cmd"], cwd=str(ROOT), stdin=subprocess.DEVNULL,
                             stdout=logf, stderr=subprocess.STDOUT,
                             start_new_session=True)
    entry["pid"] = os.getpid()
    entry["child_pid"] = child.pid
    write_json_atomic(path, entry)

    started = time.time()
    deadline = started + entry["budget_min"] * 60
    stall_sec = (entry.get("stall_min") or 0) * 60
    pattern = re.compile(entry["kill_regex"]) if entry.get("kill_regex") else None
    kill_file = WATCH_DIR / f"{entry['id']}.kill"
    tdir = (ROOT / entry["trial_dir"]) if entry.get("trial_dir") else None
    log_offset = 0
    kill_reason = None

    def freshest_output_age() -> float:
        newest = 0.0
        for f in ([log_path] + ([tdir / "results.jsonl"] if tdir else [])):
            try:
                newest = max(newest, f.stat().st_mtime)
            except OSError:
                pass
        return (time.time() - newest) if newest else 0.0

    while True:
        rc = child.poll()
        if rc is not None:
            break
        if kill_file.exists():
            kill_reason = kill_file.read_text().strip() or "killed by session request"
        elif time.time() > deadline:
            kill_reason = f"wall-clock budget {entry['budget_min']} min exceeded"
        elif stall_sec and freshest_output_age() > stall_sec:
            kill_reason = f"stalled: no new output in {entry['stall_min']} min"
        elif pattern:
            try:
                with open(log_path, "rb") as f:
                    f.seek(log_offset)
                    chunk = f.read()
                log_offset += len(chunk)
                m = pattern.search(chunk.decode("utf-8", "replace"))
                if m:
                    kill_reason = f"kill pattern matched: {m.group(0)[:80]!r}"
            except OSError:
                pass
        if kill_reason:
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except (OSError, ProcessLookupError):
                pass
            t0 = time.time()
            while child.poll() is None and time.time() - t0 < WATCH_TERM_GRACE_SEC:
                time.sleep(1)
            if child.poll() is None:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except (OSError, ProcessLookupError):
                    pass
            rc = child.wait()
            break
        entry["heartbeat"] = now_iso()
        write_json_atomic(path, entry)
        time.sleep(WATCH_POLL_SEC)

    logf.close()
    entry["exit_code"] = rc
    entry["ended"] = now_iso()
    entry["heartbeat"] = now_iso()
    if kill_reason:
        entry["status"] = "killed"
        entry["kill_reason"] = kill_reason
    else:
        entry["status"] = "done" if rc == 0 else "failed"
    write_json_atomic(path, entry)

    # A watchdog-killed trial is closed mechanically, right now: the LEDGER must not
    # depend on a session coming back to admit the kill. The stub summary states
    # facts only; the next session may enrich it, never delete it.
    if tdir is not None and kill_reason:
        summary = tdir / "summary.md"
        if not summary.exists() or not summary.read_text().strip():
            n_rows = 0
            try:
                n_rows = sum(1 for _ in open(tdir / "results.jsonl"))
            except OSError:
                pass
            summary.write_text(
                f"# summary — {entry['name']} (KILLED by watchdog)\n\n"
                f"- reason: {kill_reason}\n"
                f"- started {entry['started']}, killed {entry['ended']}, "
                f"exit code {rc}\n"
                f"- results.jsonl rows at kill: {n_rows}\n\n"
                f"Facts-only stub written mechanically by `lab watch`. Verdict: n/a. "
                f"The next session should read results.jsonl/console.log and enrich "
                f"this summary if the numbers matter.\n")
        subprocess.run(
            [sys.executable, str(Path(__file__).resolve()), "trial", "done",
             str(tdir), "--killed", "--reason", kill_reason],
            cwd=str(ROOT), stdin=subprocess.DEVNULL, capture_output=True)


def cmd_watch_list(args) -> None:
    entries = [_watch_repair(e) for e in _watch_entries()]
    if args.json:
        print(json.dumps(entries, indent=2))
        return
    if not entries:
        print("no watches (archive: .lab/watch/done/)")
        return
    for e in entries:
        extra = f" kill_reason={e['kill_reason']!r}" if e.get("kill_reason") else ""
        print(f"{e['id']}  {e['kind']}:{e['name']}  {e['status']}"
              f"  budget={e['budget_min']}min  log={e['log']}{extra}")


def cmd_watch_check(args) -> None:
    entries = [_watch_repair(e) for e in _watch_entries()]
    live = [e for e in entries if e["status"] == "running"]
    pending = [e for e in entries if e["status"] != "running"]
    if args.counts:
        print(f"live={len(live)} pending={len(pending)}")
        return
    if args.fingerprint:
        sig = ";".join(f"{e['id']}:{e['status']}" for e in entries)
        print(hashlib.sha256(sig.encode()).hexdigest()[:12])
        return
    if args.next_deadline:
        secs = []
        for e in live:
            try:
                t0 = datetime.fromisoformat(e["started"].replace("Z", "+00:00")).timestamp()
                secs.append(int(t0 + e["budget_min"] * 60 - time.time()))
            except (ValueError, KeyError):
                pass
        print(min(secs) if secs else "")
        return
    for e in entries:
        print(f"{e['id']}  {e['status']}  heartbeat={e.get('heartbeat')}")
    if not entries:
        print("no watches")


def cmd_watch_kill(args) -> None:
    entry = next((e for e in _watch_entries() if e["id"] == args.id), None)
    if entry is None:
        die(f"no watch {args.id}")
    if entry["status"] != "running":
        die(f"watch {args.id} is {entry['status']}, not running")
    if not args.reason:
        die("--reason is required: the kill reason lands in the trial summary and LEDGER")
    (WATCH_DIR / f"{args.id}.kill").write_text(args.reason.strip() + "\n")
    print(f"kill requested; the watcher will act within {WATCH_POLL_SEC}s and "
          f"handle the paperwork")


def cmd_watch_close(args) -> None:
    path = _watch_path(args.id)
    if not path.exists():
        die(f"no watch {args.id}")
    entry = _watch_repair(json.loads(path.read_text()))
    if entry["status"] == "running":
        die(f"watch {args.id} is still running — kill it or wait for it")
    if entry["kind"] == "trial":
        state = load_state()
        if entry["id"] in state.get("active_trials", []):
            die(f"trial {entry['id']} is still open — write its summary.md and run "
                f"`lab trial done` before closing the watch")
    WATCH_ARCHIVE.mkdir(parents=True, exist_ok=True)
    path.rename(WATCH_ARCHIVE / path.name)
    kf = WATCH_DIR / f"{args.id}.kill"
    if kf.exists():
        kf.rename(WATCH_ARCHIVE / kf.name)
    print(f"archived to .lab/watch/done/{path.name}")


def cmd_protocol_freeze(args) -> None:
    fm, _ = load_protocol()
    rev = int(fm["revision"])
    dest = ROOT / "protocol" / f"rev{rev:03d}.md"
    dest.parent.mkdir(exist_ok=True)
    if dest.exists():
        existing = dest.read_text()
        if existing == PROTOCOL_PATH.read_text():
            print(f"{dest.relative_to(ROOT)} (already frozen, identical)")
            return
        die(f"{dest.relative_to(ROOT)} already exists and differs — frozen revisions "
            "are evidence. Bump `revision` in PROTOCOL.md before freezing again.")
    shutil.copyfile(PROTOCOL_PATH, dest)
    print(str(dest.relative_to(ROOT)))


def cmd_protocol_activate(args) -> None:
    state = load_state()
    fm, body = load_protocol()
    new_rev = int(fm["revision"])
    old_rev = int(state["revision"])
    if new_rev != old_rev + 1:
        die(f"PROTOCOL.md says revision {new_rev}, state says {old_rev} — a revision "
            "bumps by exactly 1 and only in the decide phase")
    frozen = ROOT / "protocol" / f"rev{old_rev:03d}.md"
    if not frozen.exists():
        die(f"revision {old_rev} was never frozen — run `lab protocol freeze` on the "
            "old text before editing PROTOCOL.md")
    if f"rev{new_rev}" not in body and f"revision {new_rev}" not in body.lower():
        die(f"the Changelog has no entry for revision {new_rev} — every revision "
            "records what changed and which result motivated it")
    shutil.copyfile(PROTOCOL_PATH, ROOT / "protocol" / f"rev{new_rev:03d}.md")
    state["revision"] = new_rev
    save_state(state)
    emit("protocol.revised", args.diff_summary or f"protocol revised to rev {new_rev}",
         {"revision": new_rev, "from": old_rev,
          "diff_summary": args.diff_summary or ""}, state=state)
    print(f"revision {old_rev} -> {new_rev}")


def cmd_gate_request(args) -> None:
    state = load_state()
    if state["status"] == "awaiting_gate":
        die(f"a gate is already open: {state['awaiting'].get('question')}")
    if state["status"] == "concluded":
        die("project is concluded")
    state["status"] = "awaiting_gate"
    state["awaiting"] = {"type": args.type, "question": args.question, "since": now_iso()}
    save_state(state)
    emit("gate.requested", args.question, {"gate_type": args.type}, state=state)
    print(f"awaiting_gate: {args.question}")


def cmd_gate_resolve(args) -> None:
    state = load_state()
    if state["status"] != "awaiting_gate" or not state.get("awaiting"):
        die("no gate is open")
    gate = state["awaiting"]
    decision = "approved" if args.approve else "rejected"
    state["awaiting"] = None
    state["status"] = "running"
    save_state(state)
    emit("gate.resolved", f"{gate.get('type', 'gate')} {decision}"
                          + (f": {args.note}" if args.note else ""),
         {"gate_type": gate.get("type"), "question": gate.get("question"),
          "decision": decision, "note": args.note or ""}, state=state)
    print(f"{decision}; status=running, phase={state['phase']}")


