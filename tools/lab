def main(argv: list[str] | None = None) -> None:
    p = argparse.ArgumentParser(prog="lab", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("init", help="bootstrap the repo from PROTOCOL.md")
    sp.add_argument("--force", action="store_true")
    sp.set_defaults(func=cmd_init)

    sp = sub.add_parser("log", help="append an event to the public feed")
    sp.add_argument("type", help=f"one of: {', '.join(sorted(EVENT_FEED))}")
    sp.add_argument("--msg", required=True, help=f"<= {MSG_MAX} chars, one line")
    sp.add_argument("--data", help="JSON object with the structured payload")
    sp.add_argument("--trial", help="trial id (required for metric throttling)")
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("events", help="read the event feed")
    sp.add_argument("action", choices=["tail"])
    sp.add_argument("-n", type=int, default=20)
    sp.add_argument("--class", dest="feed_class", choices=["news", "activity", "none"])
    sp.set_defaults(func=cmd_events)

    sp = sub.add_parser("state", help="read/write state.json")
    ssub = sp.add_subparsers(dest="state_cmd", required=True)
    g = ssub.add_parser("get")
    g.add_argument("key", nargs="?")
    g.set_defaults(func=cmd_state_get)
    s = ssub.add_parser("set")
    s.add_argument("assignments", nargs="+", metavar="key=value")
    s.set_defaults(func=cmd_state_set)

    sp = sub.add_parser("trial", help="trial dirs — the run-dir contract")
    tsub = sp.add_subparsers(dest="trial_cmd", required=True)
    t = tsub.add_parser("new")
    t.add_argument("exp_id")
    t.add_argument("--config", help="JSON object, or @path/to/config.json")
    t.add_argument("--seed", type=int)
    t.add_argument("--command", help="the exact command line being run")
    t.add_argument("--spec", help="path to the experiment spec")
    t.add_argument("--packages", help="extra comma-separated packages to fingerprint")
    t.add_argument("--note", help="one-line ledger note / launch message")
    t.set_defaults(func=cmd_trial_new)
    t = tsub.add_parser("log")
    t.add_argument("dir")
    t.add_argument("--data", required=True, help="JSON object appended to results.jsonl")
    t.add_argument("--metric-msg", help="also emit a (throttled) metric event")
    t.set_defaults(func=cmd_trial_log)
    t = tsub.add_parser("done")
    t.add_argument("dir")
    t.add_argument("--verdict", help="|".join(VERDICTS))
    t.add_argument("--killed", action="store_true")
    t.add_argument("--reason", help="why it was killed")
    t.add_argument("--note", help="one-line ledger note / event message")
    t.set_defaults(func=cmd_trial_done)

    sp = sub.add_parser("watch", help="detached watchdog for long-running work")
    wsub = sp.add_subparsers(dest="watch_cmd", required=True)
    w = wsub.add_parser("start", help="launch a command under a detached watcher")
    w.add_argument("--trial", help="trial dir: console.log is the log, kills auto-close the trial")
    w.add_argument("--op", help="name for non-trial work (a download, a corpus build)")
    w.add_argument("--budget-min", type=int,
                   help="wall-clock kill budget (trials default to config kill.max_wall_clock_hours)")
    w.add_argument("--stall-min", type=int, default=0,
                   help="kill if no new output (log/results.jsonl) for this many minutes")
    w.add_argument("--kill-regex", help="kill when this pattern appears in new log output")
    w.add_argument("command", nargs=argparse.REMAINDER,
                   help="-- <command...> to run and supervise")
    w.set_defaults(func=cmd_watch_start)
    w = wsub.add_parser("_run")           # internal: the detached watcher process
    w.add_argument("id")
    w.set_defaults(func=cmd_watch_run)
    w = wsub.add_parser("list")
    w.add_argument("--json", action="store_true")
    w.set_defaults(func=cmd_watch_list)
    w = wsub.add_parser("check", help="repair dead watchers; report live/pending")
    w.add_argument("--counts", action="store_true", help="print 'live=N pending=M'")
    w.add_argument("--fingerprint", action="store_true",
                   help="stable hash of watch ids+statuses (drivers detect change)")
    w.add_argument("--next-deadline", action="store_true",
                   help="seconds until the nearest live watch budget deadline")
    w.set_defaults(func=cmd_watch_check)
    w = wsub.add_parser("kill", help="ask the watcher to kill its child and do the paperwork")
    w.add_argument("id")
    w.add_argument("--reason", required=True)
    w.set_defaults(func=cmd_watch_kill)
    w = wsub.add_parser("close", help="archive a finished watch after its paperwork is done")
    w.add_argument("id")
    w.set_defaults(func=cmd_watch_close)

    sp = sub.add_parser("protocol", help="revision mechanism")
    psub = sp.add_subparsers(dest="protocol_cmd", required=True)
    f = psub.add_parser("freeze")
    f.set_defaults(func=cmd_protocol_freeze)
    a = psub.add_parser("activate")
    a.add_argument("--diff-summary", help="one line: what changed and why")
    a.set_defaults(func=cmd_protocol_activate)

    sp = sub.add_parser("gate", help="human checkpoints")
    gsub = sp.add_subparsers(dest="gate_cmd", required=True)
    r = gsub.add_parser("request")
    r.add_argument("--type", required=True,
                   help="revision_approval | conclude_approval | question | blocked | stalled")
    r.add_argument("--question", required=True)
    r.set_defaults(func=cmd_gate_request)
    v = gsub.add_parser("resolve")
    mx = v.add_mutually_exclusive_group(required=True)
    mx.add_argument("--approve", action="store_true")
    mx.add_argument("--reject", action="store_true")
    v.add_argument("--note")
    v.set_defaults(func=cmd_gate_resolve)

    sp = sub.add_parser("validate", help="lint the repo against the contract")
    sp.set_defaults(func=cmd_validate)

    sp = sub.add_parser("format", help="the output-format contract for consumers")
    sp.add_argument("action", choices=["show", "sync", "version"],
                    help="show = print the manifest; sync = write FORMAT.json; "
                         "version = print the format version alone")
    sp.set_defaults(func=cmd_format)

    sp = sub.add_parser("model", help="which model drives this session (requested + served)")
    sp.add_argument("--json", action="store_true",
                    help="print {requested, requested_source, served, served_source}")
    sp.set_defaults(func=cmd_model)

    sp = sub.add_parser("conf", help="read .claude/loop.conf")
    sp.add_argument("key", nargs="?")
    sp.set_defaults(func=cmd_conf)

    args = p.parse_args(argv)

    # state.json / events.jsonl / LEDGER.md are read-modify-write; with detached
    # watchers closing trials while a session works, writers can now be concurrent.
    # One blocking flock serializes them. The watcher's long-lived `_run` loop never
    # takes it (it mutates only its own registry file and shells back into `lab
    # trial done`, which takes the lock in its own short-lived process).
    mutating = args.cmd in ("init", "log", "state", "trial", "protocol", "gate") \
        and not (args.cmd == "state" and getattr(args, "state_cmd", "") == "get")
    if mutating:
        LAB_DIR.mkdir(parents=True, exist_ok=True)
        lock = open(LAB_DIR / "lab.lock", "w")
        t0 = time.time()
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.time() - t0 > 120:
                    die("could not take .lab/lab.lock within 120s — another lab "
                        "process is stuck holding it")
                time.sleep(0.2)
    args.func(args)


if __name__ == "__main__":
    main()
